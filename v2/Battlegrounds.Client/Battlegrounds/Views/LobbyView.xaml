<UserControl x:Class="Battlegrounds.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Battlegrounds.Views"
             xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
             xmlns:behaviors="clr-namespace:Battlegrounds.Behaviors"
             xmlns:converters="clr-namespace:Battlegrounds.Converters"
             xmlns:controls="clr-namespace:Battlegrounds.Controls"
             xmlns:selectors="clr-namespace:Battlegrounds.Selectors"
             d:DataContext="{d:DesignInstance Type=viewmodels:LobbyViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <converters:LockImageConverter x:Key="LockImageConverter"/>
        <converters:LockStateConverter x:Key="LockStateConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:MatchButtonStateConverter x:Key="MatchButtonStateConverter"/>
        <converters:ButtonStateToContentConverter x:Key="ButtonStateToContentConverter"/>
        <converters:ReadyStateConverter x:Key="ReadyStateConverter"/>
        <converters:UpperCaseConverter x:Key="UpperCase"/>
        <converters:FactionIconMultiBindingConverter x:Key="FactionIconConverter"/>
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <converters:DownloadProgressArcConverter x:Key="DownloadProgressArcConverter"/>

        <DataTemplate x:Key="CompanyComboBoxItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Faction icon -->
                <Image Width="{DynamicResource Size.Icon.S}" Height="{DynamicResource Size.Icon.S}" Margin="0,0,8,0"
               Source="{Binding Company.Faction, Converter={StaticResource FactionIconConverter}, ConverterParameter=CoH3}"
               Visibility="{Binding Company, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                <!-- Company name -->
                <TextBlock Grid.Column="1" 
                   Text="{Binding Company.Name, FallbackValue='None', TargetNullValue='Random AI Company'}"
                   VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="CompanySelectionComboBox" TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Default}">
            <Setter Property="ItemTemplate" Value="{StaticResource CompanyComboBoxItemTemplate}"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="Slot" TargetType="{x:Type ContentControl}">
            <Style.Setters>
                <Setter Property="Height" Value="60"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Hairline}"/>
                <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContentControl}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    x:Name="SlotBorder"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Visibility="{Binding Slot.Hidden, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                    CornerRadius="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Player Icon/Avatar -->
                                    <Ellipse 
                                        Width="{DynamicResource Size.Icon.XL}" 
                                        Height="{DynamicResource Size.Icon.XL}" 
                                        Margin="10,0,0,0" 
                                        Grid.Column="0" 
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasOccupant, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Ellipse.Fill>
                                            <ImageBrush 
                                                ImageSource="pack://application:,,,/Battlegrounds;component/Assets/dummy_avatar.png"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!--
                                        Company download progress doughnut (overlays avatar, hidden when progress = 0).

                                        The Viewbox is load-bearing: the geometry below is authored against a
                                        40x40 box (centre 20,20, radii 16 and 10) and DownloadProgressArcConverter
                                        emits arcs in those same coordinates. Resizing the container alone would
                                        leave the donut drawn at 40px inside it. The Viewbox scales the whole
                                        40x40 design box up to the icon token instead.
                                    -->
                                    <Viewbox Width="{DynamicResource Size.Icon.XL}" Height="{DynamicResource Size.Icon.XL}"
                                             Margin="10,0,0,0"
                                             Grid.Column="0"
                                             VerticalAlignment="Center"
                                             Stretch="Uniform"
                                             Visibility="Collapsed">

                                        <!-- TODO: Use this:
                                        Visibility="{Binding CompanyDownloadProgress, Converter={StaticResource ZeroToVisibilityConverter}}"
                                        -->

                                    <Grid Width="40" Height="40">

                                        <!-- Background track ring (full donut, semi-transparent) -->
                                        <Path Fill="{StaticResource Brush.Surface.Track}">
                                            <Path.Data>
                                                <PathGeometry FillRule="EvenOdd">
                                                    <PathFigure StartPoint="20,4" IsClosed="True">
                                                        <ArcSegment Point="20,36" Size="16,16" IsLargeArc="True" SweepDirection="Clockwise"/>
                                                        <ArcSegment Point="20,4"  Size="16,16" IsLargeArc="True" SweepDirection="Clockwise"/>
                                                    </PathFigure>
                                                    <PathFigure StartPoint="20,10" IsClosed="True">
                                                        <ArcSegment Point="20,30" Size="10,10" IsLargeArc="True" SweepDirection="Clockwise"/>
                                                        <ArcSegment Point="20,10" Size="10,10" IsLargeArc="True" SweepDirection="Clockwise"/>
                                                    </PathFigure>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>

                                        <!-- Progress arc -->
                                        <Path Fill="{StaticResource Brush.Accent.Gold}"
                                              Data="{Binding CompanyDownloadProgress, Converter={StaticResource DownloadProgressArcConverter}}"/>

                                    </Grid>
                                    </Viewbox>

                                    <!-- Player Name -->
                                    <TextBlock Text="{Binding DisplayName}" 
                                               Grid.Column="1"
                                               FontWeight="SemiBold"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               x:Name="DisplayName"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    
                                    <!-- Company Selection -->
                                    <Grid
                                        Grid.Column="2"
                                        Visibility="{Binding HasOccupant, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,0,8,0">
                                        
                                        <!-- Company selection -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding CanSetCompany, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ComboBox
                                                       Width="220" Height="42"
                                                       ItemsSource="{Binding AvailableCompanies}"
                                                       SelectedItem="{Binding DraftSelectedCompany, Mode=TwoWay}"
                                                       behaviors:SelectionChangedCommandBehavior.Command="{Binding SetCompanyCommand}"
                                                       behaviors:SelectionChangedCommandBehavior.CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                                                       Style="{StaticResource ComboBox.Default}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Faction icon -->
                                                            <Image Width="{DynamicResource Size.Icon.L}" Height="{DynamicResource Size.Icon.L}" Margin="0,0,8,0">
                                                                <Image.Source>
                                                                    <MultiBinding Converter="{StaticResource FactionIconConverter}">
                                                                        <Binding Path="Company.Faction"/>
                                                                        <Binding Path="Company.GameId"/>
                                                                    </MultiBinding>
                                                                </Image.Source>
                                                            </Image>

                                                            <!-- Company name -->
                                                            <TextBlock Grid.Column="1" 
                                                              Text="{Binding DisplayName}"
                                                              VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Selected company (view-only, clickable for preview) -->
                                        <Button
                                            Margin="10,0,0,0"
                                            Height="42"
                                            Width="220"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Button.Subtle}"
                                            Command="{Binding ShowCompanyPreviewCommand}"
                                            Visibility="{Binding CanSetCompany, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="{DynamicResource Size.Icon.L}" Height="{DynamicResource Size.Icon.L}" VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource FactionIconConverter}">
                                                            <Binding Path="SelectedCompany.Faction"/>
                                                            <Binding Path="SelectedCompany.GameId"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>

                                                <TextBlock Text="{Binding SelectedCompany.DisplayName}"
                                                       FontWeight="SemiBold"
                                                           Margin="8,0,8,6"
                                                           VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Text.Dim}"/>
                                            </StackPanel>
                                        </Button>

                                    </Grid>
                                    
                                    <!-- Move to slot (if occupiable) -->
                                    <Button
                                            Content="Move to Slot"
                                            Height="42"
                                        Grid.Column="2"
                                        Margin="0,0,8,0"
                                            Width="220"
                                            Style="{StaticResource Button.Primary}"
                                            Command="{Binding MoveToSlotCommand}"
                                            CommandParameter="{Binding Slot.Index}"
                                            Visibility="{Binding IsOccupiable, Converter={StaticResource BoolToVisibilityConverter}}"/>


                                    <!-- Controls (Lock/Unlock, AI Options) -->
                                    <StackPanel Grid.Column="3" 
                                            Orientation="Horizontal" 
                                            Margin="0,0,10,0"
                                            Visibility="{Binding ParentContext.IsHost, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- AI Difficulty ComboBox (shown only when adding an AI) -->
                                        <ComboBox Width="220" Height="42"
                                                  Margin="10,0,0,0"
                                                  ItemsSource="{Binding AvailableAIDifficulties}"
                                                  SelectedItem="{Binding DraftSelectedAIDifficulty, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  behaviors:SelectionChangedCommandBehavior.Command="{Binding DifficultyCommand}"
                                                  behaviors:SelectionChangedCommandBehavior.CommandParameter="{Binding SelectedItem.Difficulty, RelativeSource={RelativeSource Self}}"
                                                  Style="{StaticResource ComboBox.Default}"
                                                  Visibility="{Binding CanSetAIDifficulty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Lock/Unlock Button (shown only if slot is unoccupied) -->
                                        <Button Width="30" Height="42" 
                                            Margin="5,0"
                                                Style="{StaticResource Button.Bare}"
                                            ToolTip="{Binding Slot.Locked, Converter={StaticResource LockStateConverter}}"
                                            Command="{Binding LockUnlockCommand}"
                                            CommandParameter="{Binding Slot.Index}"
                                            Visibility="{Binding DisplayName, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                                            <Image 
                                                Source="{Binding Slot.Locked, Converter={StaticResource LockImageConverter}}"/>
                                        </Button>

                                    </StackPanel>

                                    <!-- Stylise when working on multiplayer
                                    <Button
                                        Grid.Column="4"
                                        Content="X"
                                        Width="28"
                                        Height="42"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding CanKickOccupant, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        -->
                                    
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                    <Setter TargetName="SlotBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsOccupiable}" Value="True">
                                    <Setter TargetName="DisplayName" Property="Text" Value="Open Slot"/>
                                    <Setter TargetName="DisplayName" Property="Foreground" Value="{StaticResource Brush.Text.Dim}"/>
                                    <Setter TargetName="DisplayName" Property="FontStyle" Value="Italic"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Slot.Locked}" Value="True">
                                    <Setter TargetName="DisplayName" Property="Text" Value="Locked Slot"/>
                                    <Setter TargetName="DisplayName" Property="Foreground" Value="{StaticResource Brush.Text.Dim}"/>
                                    <Setter TargetName="DisplayName" Property="FontStyle" Value="Italic"/>
                                </DataTrigger>

                            </ControlTemplate.Triggers>
                            
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
        </Style>

        <DataTemplate x:Key="BooleanSettingTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Content="{Binding Name}"
                          IsChecked="{Binding DraftBoolValue, Mode=TwoWay}"
                          Foreground="{StaticResource Brush.Text.Primary}"
                          IsEnabled="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Margin="0,5"/>
                <Button Grid.Column="1"
                        Content="Apply"
                        Width="55"
                        Height="30"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding ApplyCommand}"
                        Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="IntegerSettingTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Name}"
                 Foreground="{StaticResource Brush.Text.Primary}"
                 Grid.Column="0" Grid.Row="0"/>

                <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0">
                    <TextBlock Text="{Binding DraftIntValue}"
                     Foreground="{StaticResource Brush.Accent.Gold}"
                     Margin="5,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Apply"
                        Width="55"
                        Height="30"
                        Margin="5,0,0,0"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding ApplyCommand}"
                        Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Slider Grid.Row="1" Grid.ColumnSpan="3"
               Minimum="{Binding MinValue}"
               Maximum="{Binding MaxValue}"
               Value="{Binding DraftIntValue, Mode=TwoWay}"
               IsSnapToTickEnabled="True"
               TickFrequency="{Binding Step}"
               IsEnabled="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Margin="0,5,0,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SelectionSettingTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}"
                 Foreground="{StaticResource Brush.Text.Primary}"
                 VerticalAlignment="Center"/>

                <Grid Grid.Column="1">
                    <!-- For host: editable combo box -->
                    <ComboBox
                      ItemsSource="{Binding Options}"
                      DisplayMemberPath="Name"
                      SelectedIndex="{Binding DraftSelectedOptionIndex, Mode=TwoWay}"
                      Width="150"
                      behaviors:SelectionChangedCommandBehavior.Command="{Binding ApplyCommand}"
                      Style="{StaticResource ComboBox.Default}"
                Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- For non-host: read-only text -->
                    <TextBlock 
                Text="{Binding SelectedOption.Name}"
                Foreground="{StaticResource Brush.Text.Dim}"
                VerticalAlignment="Center"
                Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <selectors:SettingTemplateSelector x:Key="SettingTemplateSelector"
            BooleanSettingTemplate="{StaticResource BooleanSettingTemplate}"
            IntegerSettingTemplate="{StaticResource IntegerSettingTemplate}"
            SelectionSettingTemplate="{StaticResource SelectionSettingTemplate}"/>


        <!-- StartMatchButton Style -->
        <Style x:Key="StartMatchButton" TargetType="Button">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Section}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid">
                            <!--
                                Animated pulse border for the Starting state.

                                BorderBrush stays a literal rather than a token: the
                                storyboard below animates this brush's Color, and a brush
                                taken from a resource dictionary is frozen and cannot be
                                animated. It starts fully transparent.
                            -->
                            <Border x:Name="PulseBorder"
                            BorderThickness="2"
                            CornerRadius="0"
                            BorderBrush="#00FFFFFF"
                            Opacity="0"
                            Margin="-4"/>

                            <!-- Main button border -->
                            <Border x:Name="MainBorder" 
                           Background="{StaticResource Brush.Surface.Card}"
                           BorderBrush="{StaticResource Brush.Border.Hairline}"
                           BorderThickness="1"
                           CornerRadius="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Content -->
                                    <ContentPresenter x:Name="ContentPresenter" 
                                         HorizontalAlignment="Center" 
                                         VerticalAlignment="Center"
                                         Grid.ColumnSpan="2"/>

                                    <!-- Animated dots for waiting state -->
                                    <StackPanel x:Name="WaitingDots" 
                                       Orientation="Horizontal" 
                                       HorizontalAlignment="Right" 
                                       Grid.Column="1"
                                       Margin="0,0,20,0"
                                       Opacity="0">
                                        <Ellipse x:Name="Dot1" Width="{DynamicResource Size.Dot}" Height="{DynamicResource Size.Dot}" Fill="{StaticResource Brush.Text.Primary}" Margin="3,0"/>
                                        <Ellipse x:Name="Dot2" Width="{DynamicResource Size.Dot}" Height="{DynamicResource Size.Dot}" Fill="{StaticResource Brush.Text.Primary}" Margin="3,0"/>
                                        <Ellipse x:Name="Dot3" Width="{DynamicResource Size.Dot}" Height="{DynamicResource Size.Dot}" Fill="{StaticResource Brush.Text.Primary}" Margin="3,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- CanStart state - Green color -->
                            <Trigger Property="Tag" Value="CanStart">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Success}"/>
                                <Setter Property="BorderBrush" TargetName="MainBorder" Value="{StaticResource Brush.Status.SuccessHover}"/>
                                <Setter Property="IsEnabled" Value="True"/>
                                <Setter TargetName="PulseBorder" Property="Opacity" Value="0"/>
                            </Trigger>

                            <!-- CannotStart state -->
                            <Trigger Property="Tag" Value="CannotStart">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Surface.Sunken}"/>
                                <Setter Property="Opacity" Value="0.7"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter TargetName="PulseBorder" Property="Opacity" Value="0"/>
                            </Trigger>

                            <!-- Starting state with pulse animation -->
                            <Trigger Property="Tag" Value="Starting">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Caution}"/>
                                <Setter Property="BorderBrush" TargetName="MainBorder" Value="{StaticResource Brush.Status.CautionHover}"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Visibility" TargetName="PulseBorder" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Pulse border animation -->
                                            <ColorAnimation 
                                        Storyboard.TargetName="PulseBorder" 
                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                        From="{StaticResource Color.Caution.Transparent}" To="{StaticResource Color.Amber.400}" Duration="0:0:0.75" 
                                        AutoReverse="True"/>
                                            <DoubleAnimation 
                                        Storyboard.TargetName="PulseBorder"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0" To="1" Duration="0:0:0.75"
                                        AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>

                            <!-- Waiting state with dots animation -->
                            <Trigger Property="Tag" Value="Waiting">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Danger}"/>
                                <Setter Property="BorderBrush" TargetName="MainBorder" Value="{StaticResource Brush.Status.DangerHover}"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Visibility" TargetName="WaitingDots" Value="Visible"/>
                                <Setter Property="Opacity" TargetName="WaitingDots" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Dot 1 animation -->
                                            <DoubleAnimation 
                                        Storyboard.TargetName="Dot1" 
                                        Storyboard.TargetProperty="Opacity"
                                        From="1.0" To="0.3" Duration="0:0:0.6" 
                                        AutoReverse="True"
                                        BeginTime="0:0:0.0"/>
                                            <!-- Dot 2 animation -->
                                            <DoubleAnimation 
                                        Storyboard.TargetName="Dot2" 
                                        Storyboard.TargetProperty="Opacity"
                                        From="1.0" To="0.3" Duration="0:0:0.6" 
                                        AutoReverse="True"
                                        BeginTime="0:0:0.2"/>
                                            <!-- Dot 3 animation -->
                                            <DoubleAnimation 
                                        Storyboard.TargetName="Dot3" 
                                        Storyboard.TargetProperty="Opacity"
                                        From="1.0" To="0.3" Duration="0:0:0.6" 
                                        AutoReverse="True"
                                        BeginTime="0:0:0.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>

                            <!-- Ready state - Green color (player is ready) -->
                            <Trigger Property="Tag" Value="Ready">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Success}"/>
                                <Setter Property="BorderBrush" TargetName="MainBorder" Value="{StaticResource Brush.Status.SuccessHover}"/>
                                <Setter Property="IsEnabled" Value="True"/>
                                <Setter TargetName="PulseBorder" Property="Opacity" Value="0"/>
                            </Trigger>

                            <!-- Unready state - Orange/Yellow color (player is not ready) -->
                            <Trigger Property="Tag" Value="Unready">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Caution}"/>
                                <Setter Property="BorderBrush" TargetName="MainBorder" Value="{StaticResource Brush.Status.CautionHover}"/>
                                <Setter Property="IsEnabled" Value="True"/>
                                <Setter TargetName="PulseBorder" Property="Opacity" Value="0"/>
                            </Trigger>

                            <!-- Hover state for CanStart -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="CanStart"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.SuccessHover}"/>
                            </MultiTrigger>

                            <!-- Pressed state for CanStart -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="Tag" Value="CanStart"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Success}"/>
                            </MultiTrigger>

                            <!-- Hover state for Ready -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="Ready"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.SuccessHover}"/>
                            </MultiTrigger>

                            <!-- Pressed state for Ready -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="Tag" Value="Ready"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Success}"/>
                            </MultiTrigger>

                            <!-- Hover state for Unready -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="Unready"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.CautionHover}"/>
                            </MultiTrigger>

                            <!-- Pressed state for Unready -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="Tag" Value="Unready"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Action.PrimaryPressed}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChatMessageTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <!-- The sender name with accent color -->
                <TextBlock Text="{Binding FormattedTimestamp}" 
                 Foreground="{StaticResource Brush.Text.Primary}"
                 FontWeight="SemiBold"/>

                <!-- The sender name with accent color -->
                <TextBlock Text="{Binding FormattedChannel}" 
                 Foreground="{Binding ChannelColour}"
                 FontWeight="SemiBold"
                           Margin="4,0,0,0"/>

                <!-- The sender name with accent color -->
                <TextBlock Text="{Binding FormattedSender}" 
                 Foreground="{Binding SenderColour}"
                 FontWeight="SemiBold"
                           Margin="4,0,0,0"/>

                <!-- The message content -->
                <TextBlock Text="{Binding Message}" 
                 Foreground="{StaticResource Brush.Text.Primary}"
                 TextWrapping="Wrap"
                           Margin="4,0,0,0"/>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>
    
    <Grid> <!-- No need for margin, outer container already has one -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header with Lobby Name and Back Button -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="← GO BACK"
                    Style="{StaticResource Button.Ghost}"
                    VerticalAlignment="Center"
                    Command="{Binding LeaveCommand}"/>

            <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                <controls:Eyebrow Text="LOBBY BRIEFING" Margin="0,0,0,10"/>
                <controls:TrackedTextBlock Style="{StaticResource Display.PageTitle}"
                                           FontSize="{DynamicResource Font.Size.Title}"
                                           Text="{Binding LobbyName, Converter={StaticResource UpperCase}}"/>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!--
                The right panel takes a share of the width rather than a flat 300, so on a wide
                window it grows with the teams area instead of leaving all the extra space to
                the left. Min/Max keep the match settings legible without letting the panel
                swallow the lobby.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>                          <!-- Teams Area -->
                <ColumnDefinition Width="*" MinWidth="300" MaxWidth="440"/>  <!-- Right Panel -->
            </Grid.ColumnDefinitions>

            <!-- Left Side - Teams and Chat -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>                          <!-- Teams -->
                    <RowDefinition Height="*" MinHeight="200" MaxHeight="360"/>  <!-- Chat -->
                </Grid.RowDefinitions>

                <!-- Teams Section -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Team Labels -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                                                <controls:TrackedTextBlock Text="TEAM 1"
                                 Style="{StaticResource Display.Section}"
                                 FontSize="{DynamicResource Font.Size.Heading}"
                                 HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="1" 
                                 Text="VS" 
                                 FontSize="{DynamicResource Font.Size.PageTitle}"
                                 Margin="20,0"
                                                                  Foreground="{StaticResource Brush.Action.Primary}"
                                 FontFamily="{StaticResource Font.Heading}"
                                 FontWeight="Bold"/>

                                                <controls:TrackedTextBlock Grid.Column="2"
                                 Text="TEAM 2"
                                 Style="{StaticResource Display.Section}"
                                 FontSize="{DynamicResource Font.Size.Heading}"
                                 HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Team Slots -->
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/> <!-- Spacing -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Team 1 Slots -->
                        <ItemsControl ItemsSource="{Binding Team1Slots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource Slot}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Team 2 Slots -->
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Team2Slots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource Slot}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>

                <!-- Chat Section -->
                <Border Grid.Row="1" 
                        Margin="0,20,0,0"
                        Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="0">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Chat Messages -->
                        <ScrollViewer Style="{StaticResource ScrollViewer.Thin}">
                            <ItemsControl 
                                ItemsSource="{Binding ChatMessages}" 
                                ItemTemplate="{StaticResource ChatMessageTemplate}">
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Chat Input -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox 
                                Text="{Binding ChatMessage, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource TextBox.Field}"/>
                            <ComboBox
                                Width="130"
                                Height="30"
                                Grid.Column="1"
                                Style="{StaticResource ComboBox.Default}"
                                ItemsSource="{Binding AvailableChatChannels}"
                                DisplayMemberPath="DisplayName"
                                SelectedItem="{Binding SelectedChatChannel, Mode=TwoWay}"
                                />
                            <Button Grid.Column="2" 
                                    Style="{StaticResource Button.Primary}"
                                    Content="Send"
                                    Margin="10,0,0,0"
                                    IsDefault="True"
                                    Command="{Binding SendMessageCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Side - Map and Settings -->
            <Border Grid.Column="1" 
                    Margin="20,0,0,0"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    CornerRadius="0">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <!-- Map Preview, sized square below -->
                        <RowDefinition Height="*"/>    <!-- Settings -->
                    </Grid.RowDefinitions>

                                        <controls:TrackedTextBlock Text="MATCH SETTINGS"
                             Style="{StaticResource Display.Section}"
                             Margin="0,0,0,15"/>

                    <!--
                        Map Preview. Minimaps are square, so the container tracks its own width to
                        stay square as the panel resizes — a fixed 240 height cropped them.
                    -->
                    <Border Grid.Row="1"
                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                            Background="{StaticResource Brush.Surface.Sunken}"
                            BorderBrush="{StaticResource Brush.Border.AccentSoft}"
                            BorderThickness="1">
                        <Image Source="{Binding SelectedMapPreview, FallbackValue='Assets/Scenarios/CoH3/mm/pachino_2p_mm_handmade.png'}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <!-- Settings List -->
                    <StackPanel Grid.Row="2" Margin="0,15,0,0">
                        <Grid>
                            <TextBlock Text="{Binding SelectedMap.Name}"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource Brush.Text.Primary}"
                                       Visibility="{Binding IsHost, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ComboBox
                                    Width="260"
                                    DisplayMemberPath="Name"
                                    SelectedItem="{Binding DraftSelectedMap, Mode=TwoWay}"
                                    ItemsSource="{Binding AvailableMaps}"
                                    behaviors:SelectionChangedCommandBehavior.Command="{Binding SetMapCommand}"
                                    behaviors:SelectionChangedCommandBehavior.CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                                    Style="{StaticResource ComboBox.Default}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Settings ItemsControl with TemplateSelector -->
                        <ItemsControl ItemsSource="{Binding SelectedSettings}"
                                     ItemTemplateSelector="{StaticResource SettingTemplateSelector}"
                                     Margin="0,10,0,0">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer with Start Button -->
        <Grid Grid.Row="2" Margin="0,8,0,0">

            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <Label Content="{Binding LobbyState}"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       VerticalAlignment="Center"/>
                <Label Content="{Binding ConnectionState, StringFormat=Connection: {0}}"
                       Foreground="{StaticResource ForegroundDarkGrayBrush}"
                       VerticalAlignment="Center"/>
                <Label Content="{Binding TrayMessage}"
                       Foreground="{StaticResource Brush.Text.Faint}"
                       VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Host Button: Start Match -->
            <Button Command="{Binding StartMatchCommand}"
                    HorizontalAlignment="Right"
                    Style="{DynamicResource StartMatchButton}"
                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- Tag binding to control visual state through converter -->
                <Button.Tag>
                    <MultiBinding Converter="{StaticResource MatchButtonStateConverter}">
                        <Binding Path="IsMatchStarting" />
                        <Binding Path="IsWaitingForMatchOver" />
                        <Binding Path="CanStartMatch" />
                        <Binding Path="IsHost" />
                    </MultiBinding>
                </Button.Tag>

                <!-- Dynamic content based on state -->
                <Button.Content>
                    <TextBlock 
                        Text="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Converter={StaticResource ButtonStateToContentConverter}}"/>
                </Button.Content>
            </Button>

            <!-- Non-Host Button: Ready/Unready Toggle -->
            <Button Command="{Binding ToggleReadyCommand}"
                    HorizontalAlignment="Right"
                    Style="{DynamicResource StartMatchButton}"
                    Visibility="{Binding IsHost, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                <!-- Tag binding to control visual state -->
                <Button.Tag>
                    <Binding Path="IsReady" Converter="{StaticResource ReadyStateConverter}"/>
                </Button.Tag>

                <!-- Dynamic content based on ready state -->
                <Button.Content>
                    <TextBlock 
                        Text="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Converter={StaticResource ButtonStateToContentConverter}}"/>
                </Button.Content>
            </Button>
        </Grid>

        <!-- Match Over Overlay: shown when a match has just ended -->
        <ContentControl Grid.RowSpan="3"
                        Panel.ZIndex="100"
                        Content="{Binding MatchOverResult}"
                        Visibility="{Binding MatchOverResult, Converter={StaticResource NullVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Semi-transparent backdrop -->
                        <Rectangle Fill="{StaticResource Brush.Surface.Scrim}"/>
                        <!-- Stretched, not centred: the card centres and caps itself, so stretching
                             here is what lets it grow with the window instead of staying 760 wide. -->
                        <local:MatchOverView HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="40"/>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Company Preview Overlay: shown when inspecting another player's company -->
        <ContentControl Grid.RowSpan="3"
                        Panel.ZIndex="99"
                        Content="{Binding CompanyPreviewResult}"
                        Visibility="{Binding CompanyPreviewResult, Converter={StaticResource NullVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Semi-transparent backdrop -->
                        <Rectangle Fill="{StaticResource Brush.Surface.Scrim}"/>
                        <!-- Stretched, not centred — see the MatchOverView overlay above. -->
                        <local:CompanyPreviewView HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="40"/>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Grid>
</UserControl>
