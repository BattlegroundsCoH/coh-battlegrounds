<UserControl x:Class="Battlegrounds.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Battlegrounds.Views"
             xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
             xmlns:behaviors="clr-namespace:Battlegrounds.Behaviors"
             xmlns:converters="clr-namespace:Battlegrounds.Converters"
             xmlns:controls="clr-namespace:Battlegrounds.Controls"
             xmlns:selectors="clr-namespace:Battlegrounds.Selectors"
             d:DataContext="{d:DesignInstance Type=viewmodels:LobbyViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <converters:MatchButtonStateConverter x:Key="MatchButtonStateConverter"/>
        <converters:ButtonStateToContentConverter x:Key="ButtonStateToContentConverter"/>
        <converters:ReadyStateConverter x:Key="ReadyStateConverter"/>
        <converters:UpperCaseConverter x:Key="UpperCase"/>
        <converters:GamemodeNameConverter x:Key="GamemodeNameConverter"/>
        <converters:ConnectionStateToneConverter x:Key="ConnectionTone"/>
        <converters:ConnectionStateDescriptionConverter x:Key="ConnectionDescription"/>
        <converters:ChatToneBrushConverter x:Key="ChatToneBrush"/>


        <!--
            Match settings.

            Every setting is a label stacked above a full-width control rather than a
            label-and-control row. The panel is 300–440px wide, and a side-by-side row is
            what left "Victory Poi…" and "500 Points" clipped: a stacked row gives the
            control the whole width, so no option string can outgrow it.

            None of them has an Apply button any more. Apply is driven from the view — a
            selection change, a finished slider drag, a toggle — so LobbySettingViewModel
            keeps its draft/apply split for anything that does need an explicit commit.
        -->

        <Style x:Key="SettingLabel" TargetType="controls:TrackedTextBlock" BasedOn="{StaticResource Display.Label}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <DataTemplate x:Key="BooleanSettingTemplate">
            <CheckBox Content="{Binding Name, Converter={StaticResource GamemodeNameConverter}}"
                      IsChecked="{Binding DraftBoolValue, Mode=TwoWay}"
                      IsEnabled="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      behaviors:ToggleCommandBehavior.Command="{Binding ApplyCommand}"
                      Style="{StaticResource CheckBox.Default}"
                      Visibility="{Binding Visibility}"/>
        </DataTemplate>

        <DataTemplate x:Key="IntegerSettingTemplate">
            <StackPanel Visibility="{Binding Visibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <controls:TrackedTextBlock Text="{Binding Name, Converter={StaticResource GamemodeNameConverter}, ConverterParameter=upper}"
                                               Style="{StaticResource SettingLabel}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding DraftIntValue}"
                               Style="{StaticResource Text.Strong}"
                               Foreground="{StaticResource Brush.Accent.Gold}"/>
                </Grid>

                <!-- Commits when the gesture ends rather than on every tick; see
                     ValueCommittedCommandBehavior. -->
                <Slider Minimum="{Binding MinValue}"
                        Maximum="{Binding MaxValue}"
                        Value="{Binding DraftIntValue, Mode=TwoWay}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="{Binding Step}"
                        IsEnabled="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        behaviors:ValueCommittedCommandBehavior.Command="{Binding ApplyCommand}"
                        Style="{StaticResource Slider.Default}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SelectionSettingTemplate">
            <StackPanel Visibility="{Binding Visibility}">
                <controls:TrackedTextBlock Text="{Binding Name, Converter={StaticResource GamemodeNameConverter}, ConverterParameter=upper}"
                                           Style="{StaticResource SettingLabel}"/>

                <!-- For host: editable combo box -->
                <ComboBox ItemsSource="{Binding Options}"
                          DisplayMemberPath="Name"
                          SelectedIndex="{Binding DraftSelectedOptionIndex, Mode=TwoWay}"
                          behaviors:SelectionChangedCommandBehavior.Command="{Binding ApplyCommand}"
                          Style="{StaticResource ComboBox.Default}"
                          Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- For non-host: read-only text -->
                <TextBlock Text="{Binding SelectedOption.Name}"
                           Style="{StaticResource Text.Strong}"
                           Visibility="{Binding DataContext.IsHost, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>

        <selectors:SettingTemplateSelector x:Key="SettingTemplateSelector"
            BooleanSettingTemplate="{StaticResource BooleanSettingTemplate}"
            IntegerSettingTemplate="{StaticResource IntegerSettingTemplate}"
            SelectionSettingTemplate="{StaticResource SelectionSettingTemplate}"/>


        <!--
            StartMatchButton.

            Its own template rather than Button.Cta because of the state machine below —
            the pulse border and the waiting dots have nowhere to live in the shared one.
            Sizing is a floor plus padding, not a fixed box: the caption grows with the UI
            scale and a 280x50 frozen button cropped it at 125%.
        -->
        <Style x:Key="StartMatchButton" TargetType="Button">
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="MinHeight" Value="{DynamicResource Size.ControlLarge}"/>
            <Setter Property="Padding" Value="{DynamicResource Space.ButtonLarge}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Section}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid">
                            <!--
                                Animated pulse border for the Starting state.

                                BorderBrush stays a literal rather than a token: the
                                storyboard below animates this brush's Color, and a brush
                                taken from a resource dictionary is frozen and cannot be
                                animated. It starts fully transparent.
                            -->
                            <Border x:Name="PulseBorder"
                            BorderThickness="2"
                            CornerRadius="0"
                            BorderBrush="#00FFFFFF"
                            Opacity="0"
                            Margin="-4"/>

                            <!-- Main button border -->
                            <Border x:Name="MainBorder" 
                           Background="{StaticResource Brush.Surface.Card}"
                           BorderBrush="{StaticResource Brush.Border.Hairline}"
                           BorderThickness="1"
                           CornerRadius="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Content -->
                                    <ContentPresenter x:Name="ContentPresenter"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Margin="{TemplateBinding Padding}"
                                         Grid.ColumnSpan="2"/>

                                    <!-- Animated dots for waiting state -->
                                    <StackPanel x:Name="WaitingDots" 
                                       Orientation="Horizontal" 
                                       HorizontalAlignment="Right" 
                                       Grid.Column="1"
                                       Margin="0,0,20,0"
                                       Opacity="0">
                                        <Ellipse x:Name="Dot1" Width="{DynamicResource Size.Dot}" Height="{DynamicResource Size.Dot}" Fill="{StaticResource Brush.Text.Primary}" Margin="3,0"/>
                                        <Ellipse x:Name="Dot2" Width="{DynamicResource Size.Dot}" Height="{DynamicResource Size.Dot}" Fill="{StaticResource Brush.Text.Primary}" Margin="3,0"/>
                                        <Ellipse x:Name="Dot3" Width="{DynamicResource Size.Dot}" Height="{DynamicResource Size.Dot}" Fill="{StaticResource Brush.Text.Primary}" Margin="3,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- CanStart state - Green color -->
                            <Trigger Property="Tag" Value="CanStart">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Success}"/>
                                <Setter Property="BorderBrush" TargetName="MainBorder" Value="{StaticResource Brush.Status.SuccessHover}"/>
                                <Setter Property="IsEnabled" Value="True"/>
                                <Setter TargetName="PulseBorder" Property="Opacity" Value="0"/>
                            </Trigger>

                            <!-- CannotStart state -->
                            <Trigger Property="Tag" Value="CannotStart">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Surface.Sunken}"/>
                                <Setter Property="Opacity" Value="0.7"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter TargetName="PulseBorder" Property="Opacity" Value="0"/>
                            </Trigger>

                            <!-- Starting state with pulse animation -->
                            <Trigger Property="Tag" Value="Starting">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Caution}"/>
                                <Setter Property="BorderBrush" TargetName="MainBorder" Value="{StaticResource Brush.Status.CautionHover}"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Visibility" TargetName="PulseBorder" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Pulse border animation -->
                                            <ColorAnimation 
                                        Storyboard.TargetName="PulseBorder" 
                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                        From="{StaticResource Color.Caution.Transparent}" To="{StaticResource Color.Amber.400}" Duration="0:0:0.75" 
                                        AutoReverse="True"/>
                                            <DoubleAnimation 
                                        Storyboard.TargetName="PulseBorder"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0" To="1" Duration="0:0:0.75"
                                        AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>

                            <!-- Waiting state with dots animation -->
                            <Trigger Property="Tag" Value="Waiting">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Danger}"/>
                                <Setter Property="BorderBrush" TargetName="MainBorder" Value="{StaticResource Brush.Status.DangerHover}"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Visibility" TargetName="WaitingDots" Value="Visible"/>
                                <Setter Property="Opacity" TargetName="WaitingDots" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Dot 1 animation -->
                                            <DoubleAnimation 
                                        Storyboard.TargetName="Dot1" 
                                        Storyboard.TargetProperty="Opacity"
                                        From="1.0" To="0.3" Duration="0:0:0.6" 
                                        AutoReverse="True"
                                        BeginTime="0:0:0.0"/>
                                            <!-- Dot 2 animation -->
                                            <DoubleAnimation 
                                        Storyboard.TargetName="Dot2" 
                                        Storyboard.TargetProperty="Opacity"
                                        From="1.0" To="0.3" Duration="0:0:0.6" 
                                        AutoReverse="True"
                                        BeginTime="0:0:0.2"/>
                                            <!-- Dot 3 animation -->
                                            <DoubleAnimation 
                                        Storyboard.TargetName="Dot3" 
                                        Storyboard.TargetProperty="Opacity"
                                        From="1.0" To="0.3" Duration="0:0:0.6" 
                                        AutoReverse="True"
                                        BeginTime="0:0:0.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>

                            <!-- Ready state - Green color (player is ready) -->
                            <Trigger Property="Tag" Value="Ready">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Success}"/>
                                <Setter Property="BorderBrush" TargetName="MainBorder" Value="{StaticResource Brush.Status.SuccessHover}"/>
                                <Setter Property="IsEnabled" Value="True"/>
                                <Setter TargetName="PulseBorder" Property="Opacity" Value="0"/>
                            </Trigger>

                            <!-- Unready state - Orange/Yellow color (player is not ready) -->
                            <Trigger Property="Tag" Value="Unready">
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Caution}"/>
                                <Setter Property="BorderBrush" TargetName="MainBorder" Value="{StaticResource Brush.Status.CautionHover}"/>
                                <Setter Property="IsEnabled" Value="True"/>
                                <Setter TargetName="PulseBorder" Property="Opacity" Value="0"/>
                            </Trigger>

                            <!-- Hover state for CanStart -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="CanStart"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.SuccessHover}"/>
                            </MultiTrigger>

                            <!-- Pressed state for CanStart -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="Tag" Value="CanStart"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Success}"/>
                            </MultiTrigger>

                            <!-- Hover state for Ready -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="Ready"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.SuccessHover}"/>
                            </MultiTrigger>

                            <!-- Pressed state for Ready -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="Tag" Value="Ready"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.Success}"/>
                            </MultiTrigger>

                            <!-- Hover state for Unready -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="Unready"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Status.CautionHover}"/>
                            </MultiTrigger>

                            <!-- Pressed state for Unready -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="Tag" Value="Unready"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="MainBorder" Value="{StaticResource Brush.Action.PrimaryPressed}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A chat line: an Auto attribution column and a star message column.

            All four parts used to sit in a horizontal StackPanel, which measures its
            children with infinite width — so the message's TextWrapping could never fire
            and a long line simply ran off the card. The message needs a constrained
            column to wrap into.

            The sizes are explicit and match the input box below. Left to inherit, the log
            picked up Font.Size.Body (14) while the field it is typed into is BodySmall (13).
        -->
        <DataTemplate x:Key="ChatMessageTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock FontSize="{DynamicResource Font.Size.BodySmall}"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap">
                    <Run Text="{Binding FormattedTimestamp, Mode=OneWay}"
                         Foreground="{StaticResource Brush.Text.Faint}"/><Run Text=" "/><Run
                         Text="{Binding FormattedChannel, Mode=OneWay}"
                         Foreground="{Binding ChannelTone, Converter={StaticResource ChatToneBrush}}"/><Run
                         Text="{Binding FormattedSender, Mode=OneWay}"
                         Foreground="{Binding SenderTone, Converter={StaticResource ChatToneBrush}}"/>
                </TextBlock>

                <TextBlock Grid.Column="1"
                           Text="{Binding Message}"
                           Margin="6,0,0,0"
                           FontSize="{DynamicResource Font.Size.BodySmall}"
                           Foreground="{StaticResource Brush.Text.Body}"
                           TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>
    
    <Grid> <!-- No need for margin, outer container already has one -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!--
            Leaving the lobby is not a "back" action, so it is not in the header: it lives
            at the top of the right column, above the map, where the other lobby-level
            controls are. The connection state takes the header's trailing slot instead.
        -->
        <controls:PageHeader Grid.Row="0"
                             Eyebrow="LOBBY BRIEFING"
                             Header="{Binding LobbyName, Converter={StaticResource UpperCase}}">
            <!--
                Content goes through UpperCase rather than binding the enum straight in:
                StatusBadge renders its content with TrackedTextBlock, whose Text is a
                string DP, so an un-converted enum produced an empty chip — a green bar
                with no label on it.
            -->
            <controls:StatusBadge Content="{Binding ConnectionState, Converter={StaticResource UpperCase}}"
                                  Tone="{Binding ConnectionState, Converter={StaticResource ConnectionTone}}"
                                  ToolTip="{Binding ConnectionState, Converter={StaticResource ConnectionDescription}}"/>
        </controls:PageHeader>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!--
                The right panel takes a share of the width rather than a flat 300, so on a wide
                window it grows with the teams area instead of leaving all the extra space to
                the left. Min/Max keep the match settings legible without letting the panel
                swallow the lobby.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>                          <!-- Teams Area -->
                <ColumnDefinition Width="*" MinWidth="300" MaxWidth="440"/>  <!-- Right Panel -->
            </Grid.ColumnDefinitions>

            <!-- Left Side - Teams and Chat -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>                          <!-- Teams -->
                    <RowDefinition Height="*" MinHeight="200" MaxHeight="360"/>  <!-- Chat -->
                </Grid.RowDefinitions>

                <!-- Teams Section -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Team Labels -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <controls:TrackedTextBlock Text="TEAM 1"
                                                   Style="{StaticResource Display.Section}"
                                                   FontSize="{DynamicResource Font.Size.Heading}"
                                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="VS"
                                   FontSize="{DynamicResource Font.Size.PageTitle}"
                                   Margin="20,0"
                                   Foreground="{StaticResource Brush.Action.Primary}"
                                   FontFamily="{StaticResource Font.Heading}"
                                   FontWeight="Bold"/>

                        <controls:TrackedTextBlock Grid.Column="2"
                                                   Text="TEAM 2"
                                                   Style="{StaticResource Display.Section}"
                                                   FontSize="{DynamicResource Font.Size.Heading}"
                                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <!--
                        Team Slots.

                        Each list scrolls rather than the page. Four two-line slots need
                        more height than the teams area has at the 720px window minimum,
                        and a root ScrollViewer is not an option here — it measures with
                        infinity and would destroy the star sizing this page is built on.
                        A scroller around the list inside the panel is the shape that works.
                    -->
                    <!-- The shared-size scope spans both teams, so every slot's two rows
                         measure to the same height and the bars line up across the VS —
                         see the SharedSizeGroups in LobbySlotView. -->
                    <Grid Grid.Row="1" Margin="0,20,0,0" Grid.IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/> <!-- Spacing -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Team 1 Slots -->
                        <ScrollViewer Style="{StaticResource ScrollViewer.Thin}">
                            <ItemsControl ItemsSource="{Binding Team1Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:LobbySlotView/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Team 2 Slots -->
                        <ScrollViewer Grid.Column="2" Style="{StaticResource ScrollViewer.Thin}">
                            <ItemsControl ItemsSource="{Binding Team2Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:LobbySlotView/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Chat Section -->
                <controls:Card Grid.Row="1" Margin="0,20,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--
                            Channel picker. Two channels do not need a dropdown, and the one
                            that was here was a 130px box that clipped "All Players" at every
                            UI scale above 100%. Tabs also keep the active channel visible
                            instead of folded away behind a chevron.
                        -->
                        <Grid Margin="{DynamicResource Space.HeadingGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <controls:TrackedTextBlock Text="CHAT"
                                                       Style="{StaticResource Display.Section}"
                                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton Content="ALL"
                                             GroupName="ChatChannel"
                                             Style="{StaticResource Button.Tab}"
                                             IsChecked="{Binding IsAllChannelSelected, Mode=TwoWay}"/>
                                <RadioButton Content="TEAM"
                                             GroupName="ChatChannel"
                                             Style="{StaticResource Button.Tab}"
                                             IsChecked="{Binding IsTeamChannelSelected, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Chat Messages -->
                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource ScrollViewer.Thin}"
                                      behaviors:AutoScrollBehavior.ToEnd="True">
                            <ItemsControl ItemsSource="{Binding ChatMessages}"
                                          ItemTemplate="{StaticResource ChatMessageTemplate}"/>
                        </ScrollViewer>

                        <!--
                            Chat Input. Neither child carries a height: in an Auto row they
                            stretch to the tallest, which is how the field and the button end
                            up level. The three fixed heights that used to be here were three
                            different numbers.
                        -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding ChatMessage, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBox.Field}"
                                     controls:ControlAssist.Placeholder="Type a message…"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Primary}"
                                    Content="SEND"
                                    Margin="10,0,0,0"
                                    IsDefault="True"
                                    Command="{Binding SendMessageCommand}"/>
                        </Grid>
                    </Grid>
                </controls:Card>
            </Grid>

            <!-- Right Side - Leaving, Map and Settings -->
            <Grid Grid.Column="1" Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Red, same as START MATCH: the two lobby-level verdicts, separated by
                     size and tracking rather than hue. -->
                <Button Content="LEAVE LOBBY"
                        Style="{StaticResource Button.Danger}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,20"
                        Command="{Binding LeaveCommand}"/>

                <controls:Card Grid.Row="1" Header="MATCH SETTINGS">
                    <DockPanel LastChildFill="True">

                        <!--
                            Map Preview. Minimaps are square, so the container tracks its own width to
                            stay square as the panel resizes — a fixed 240 height cropped them.
                        -->
                        <Border DockPanel.Dock="Top"
                                Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                Background="{StaticResource Brush.Surface.Sunken}"
                                BorderBrush="{StaticResource Brush.Border.AccentSoft}"
                                BorderThickness="{StaticResource Stroke.Hairline}">
                            <Image Source="{Binding SelectedMapPreview, FallbackValue='Assets/Scenarios/CoH3/mm/pachino_2p_mm_handmade.png'}"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <!-- The settings scroll. The list used to be an unbounded StackPanel
                             in a star row, so a long one simply ran off the bottom of the
                             panel with nothing to say so. -->
                        <ScrollViewer Style="{StaticResource ScrollViewer.Thin}"
                                      Margin="0,20,0,0">
                            <StackPanel>

                                <controls:TrackedTextBlock Text="MAP" Style="{StaticResource SettingLabel}"/>

                                <TextBlock Text="{Binding SelectedMap.Name}"
                                           Style="{StaticResource Text.Strong}"
                                           Visibility="{Binding IsHost, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                <ComboBox DisplayMemberPath="Name"
                                          SelectedItem="{Binding DraftSelectedMap, Mode=TwoWay}"
                                          ItemsSource="{Binding AvailableMaps}"
                                          behaviors:SelectionChangedCommandBehavior.Command="{Binding SetMapCommand}"
                                          behaviors:SelectionChangedCommandBehavior.CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                                          Style="{StaticResource ComboBox.Default}"
                                          Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Settings ItemsControl with TemplateSelector -->
                                <ItemsControl ItemsSource="{Binding SelectedSettings}"
                                              ItemTemplateSelector="{StaticResource SettingTemplateSelector}"
                                              Margin="0,20,0,0">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,0,18"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </controls:Card>
            </Grid>
        </Grid>

        <!--
            Footer.

            The columns repeat the main content area's above, so the match button sits in
            the same track as the settings panel and lines up with LEAVE LOBBY at the top
            of it. Aligned by construction rather than by a matching fixed width, which
            would drift the moment either side changed.
        -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*" MinWidth="300" MaxWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- TextBlocks, not Labels: a Label brings its own padding and takes none of
                 the type styles, which is why these three sat at odd intervals. The
                 connection state moved up to the page header. -->
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding LobbyState}"
                           Style="{StaticResource Text.Strong}"/>
                <TextBlock Text="{Binding TrayMessage}"
                           Style="{StaticResource Text.Meta}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Host Button: Start Match -->
            <Button Grid.Column="1"
                    Command="{Binding StartMatchCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="20,0,0,0"
                    Style="{DynamicResource StartMatchButton}"
                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- Tag binding to control visual state through converter -->
                <Button.Tag>
                    <MultiBinding Converter="{StaticResource MatchButtonStateConverter}">
                        <Binding Path="IsMatchStarting" />
                        <Binding Path="IsWaitingForMatchOver" />
                        <Binding Path="CanStartMatch" />
                        <Binding Path="IsHost" />
                    </MultiBinding>
                </Button.Tag>

                <!-- Dynamic content based on state -->
                <Button.Content>
                    <TextBlock 
                        Text="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Converter={StaticResource ButtonStateToContentConverter}}"/>
                </Button.Content>
            </Button>

            <!-- Non-Host Button: Ready/Unready Toggle -->
            <Button Grid.Column="1"
                    Command="{Binding ToggleReadyCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="20,0,0,0"
                    Style="{DynamicResource StartMatchButton}"
                    Visibility="{Binding IsHost, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                <!-- Tag binding to control visual state -->
                <Button.Tag>
                    <Binding Path="IsReady" Converter="{StaticResource ReadyStateConverter}"/>
                </Button.Tag>

                <!-- Dynamic content based on ready state -->
                <Button.Content>
                    <TextBlock 
                        Text="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Converter={StaticResource ButtonStateToContentConverter}}"/>
                </Button.Content>
            </Button>
        </Grid>

        <!-- Match Over Overlay: shown when a match has just ended -->
        <ContentControl Grid.RowSpan="3"
                        Panel.ZIndex="100"
                        Content="{Binding MatchOverResult}"
                        Visibility="{Binding MatchOverResult, Converter={StaticResource NullVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Semi-transparent backdrop -->
                        <Rectangle Fill="{StaticResource Brush.Surface.Scrim}"/>
                        <!-- Stretched, not centred: the card centres and caps itself, so stretching
                             here is what lets it grow with the window instead of staying 760 wide. -->
                        <local:MatchOverView HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="40"/>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Company Preview Overlay: shown when inspecting another player's company -->
        <ContentControl Grid.RowSpan="3"
                        Panel.ZIndex="99"
                        Content="{Binding CompanyPreviewResult}"
                        Visibility="{Binding CompanyPreviewResult, Converter={StaticResource NullVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Semi-transparent backdrop -->
                        <Rectangle Fill="{StaticResource Brush.Surface.Scrim}"/>
                        <!-- Stretched, not centred — see the MatchOverView overlay above. -->
                        <local:CompanyPreviewView HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="40"/>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Grid>
</UserControl>
