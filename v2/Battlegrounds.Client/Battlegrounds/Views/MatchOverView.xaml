<UserControl x:Class="Battlegrounds.Views.MatchOverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Battlegrounds.Converters"
             xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
             xmlns:controls="clr-namespace:Battlegrounds.Controls"
             d:DataContext="{d:DesignInstance Type=viewmodels:MatchOverViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="720">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <converters:DurationConverter x:Key="DurationConverter"/>
        <converters:ScenarioIdToNameConverter x:Key="ScenarioConverter"/>
        <converters:BlueprintIconMultiBindingConverter x:Key="BlueprintIconMultiConverter"/>
    </UserControl.Resources>

    <Border Width="760"
            MaxHeight="620"
            Background="{StaticResource Brush.Surface.Raised}"
            BorderBrush="{StaticResource Brush.Border.Strong}"
            BorderThickness="1">
        <Grid Margin="30,24,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Outcome banner -->
                <RowDefinition Height="Auto"/> <!-- Metadata row -->
                <RowDefinition Height="Auto"/> <!-- Bad events warning -->
                <RowDefinition Height="Auto"/> <!-- Table header -->
                <RowDefinition Height="*"/>    <!-- Squad rows -->
                <RowDefinition Height="Auto"/> <!-- Close button -->
            </Grid.RowDefinitions>

            <!-- Outcome Banner -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <controls:TrackedTextBlock Text="VICTORY!"
                           Style="{StaticResource Display.Hero}"
                           Tracking="{StaticResource Track.Wide}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.Status.Success}"
                           Visibility="{Binding IsVictory, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <controls:TrackedTextBlock Text="DEFEAT"
                           Style="{StaticResource Display.Hero}"
                           Tracking="{StaticResource Track.Wide}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.Status.DangerText}"
                           Visibility="{Binding IsVictory, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <TextBlock Style="{StaticResource Text.Body}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Dim}"
                           Margin="0,4,0,0">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource ScenarioConverter}">
                            <Binding Path="Scenario"/>
                            <Binding Path="Game"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- Match Metadata -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="Duration: " Foreground="{StaticResource Brush.Text.Dim}"/>
                    <TextBlock Text="{Binding MatchDuration, Converter={StaticResource DurationConverter}}"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status: " Foreground="{StaticResource Brush.Text.Dim}"/>
                    <TextBlock Text="Concluded"
                               Foreground="{StaticResource Brush.Status.Success}"
                               FontWeight="SemiBold"
                               Visibility="{Binding Concluded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="Abandoned"
                               Foreground="{StaticResource Brush.Status.Danger}"
                               FontWeight="SemiBold"
                               Visibility="{Binding Concluded, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>

            <!-- Bad Events Warning -->
            <Border Grid.Row="2"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Status.Danger}"
                    BorderThickness="1"
                                        Padding="12,6"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasBadEvents, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="⚠  Match data may be incomplete due to replay inconsistencies."
                           Foreground="{StaticResource Brush.Status.DangerText}"/>
            </Border>

            <!-- Squad Table Header -->
            <Grid Grid.Row="3" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <controls:TrackedTextBlock Text="SQUAD" Grid.Column="0" Style="{StaticResource Display.Label}" FontSize="{DynamicResource Font.Size.Meta}" Tracking="{StaticResource Track.Wide}" Margin="8,0,0,0"/>
                <controls:TrackedTextBlock Text="INF. KILLS" Grid.Column="1" Style="{StaticResource Display.Label}" FontSize="{DynamicResource Font.Size.Meta}" Tracking="{StaticResource Track.Wide}"/>
                <controls:TrackedTextBlock Text="VEH. KILLS" Grid.Column="2" Style="{StaticResource Display.Label}" FontSize="{DynamicResource Font.Size.Meta}" Tracking="{StaticResource Track.Wide}"/>
                <controls:TrackedTextBlock Text="LOSSES" Grid.Column="3" Style="{StaticResource Display.Label}" FontSize="{DynamicResource Font.Size.Meta}" Tracking="{StaticResource Track.Wide}"/>
                <controls:TrackedTextBlock Text="XP" Grid.Column="4" Style="{StaticResource Display.Label}" FontSize="{DynamicResource Font.Size.Meta}" Tracking="{StaticResource Track.Wide}"/>
                <controls:TrackedTextBlock Text="STATUS" Grid.Column="5" Style="{StaticResource Display.Label}" FontSize="{DynamicResource Font.Size.Meta}" Tracking="{StaticResource Track.Wide}"/>
                <controls:TrackedTextBlock Text="PICKUP" Grid.Column="6" Style="{StaticResource Display.Label}" FontSize="{DynamicResource Font.Size.Meta}" Tracking="{StaticResource Track.Wide}"/>
            </Grid>

            <!-- Squad Rows -->
            <ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource ScrollViewer.Thin}"
                          MaxHeight="260">
                <ItemsControl ItemsSource="{Binding SquadSummaries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4"
                                    Padding="0,7"
                                    Background="{StaticResource Brush.Surface.Card}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel 
                                        Orientation="Horizontal"
                                        Grid.Column="0"
                                               Margin="8,0,0,0">

                                        <Image Width="{DynamicResource Size.Icon.L}" Height="{DynamicResource Size.Icon.L}"
                                               VerticalAlignment="Center">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                                    <Binding Path="Blueprint"/>
                                                    <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>

                                        <TextBlock
                                               Foreground="{StaticResource Brush.Accent.Gold}"
                                               FontFamily="{StaticResource Font.Heading}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0">
                                            <Run>#</Run>
                                            <Run Text="{Binding SquadId}"/>
                                        </TextBlock>

                                    </StackPanel>
                                    
                                    <TextBlock Text="{Binding InfantryKilled}"
                                               Grid.Column="1"
                                               Foreground="{StaticResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding VehiclesDestroyed}"
                                               Grid.Column="2"
                                               Foreground="{StaticResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding Losses}"
                                               Grid.Column="3"
                                               Foreground="{StaticResource Brush.Status.DangerText}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding ExperienceGained, StringFormat=F0}"
                                               Grid.Column="4"
                                               Foreground="{StaticResource Brush.Status.Success}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="KIA"
                                               Grid.Column="5"
                                               Foreground="{StaticResource Brush.Status.Danger}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding WasKilled, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <TextBlock Text="{Binding PickedUpBlueprint}"
                                               Grid.Column="6"
                                               Foreground="{StaticResource Brush.Accent.Gold}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PickedUpBlueprint}"
                                               Visibility="{Binding PickedUpBlueprint, Converter={StaticResource NullVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Close Button -->
            <Button Grid.Row="5"
                    Content="RETURN TO LOBBY"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Padding="32,12"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding CloseCommand}"/>
        </Grid>
    </Border>

</UserControl>
