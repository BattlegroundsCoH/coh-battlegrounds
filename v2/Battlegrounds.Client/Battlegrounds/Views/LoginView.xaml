<UserControl x:Class="Battlegrounds.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
             xmlns:controls="clr-namespace:Battlegrounds.Controls"
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
             d:DesignHeight="980"
             d:DesignWidth="1720"
             Background="{StaticResource Brush.Surface.Chrome}"
             FontFamily="{StaticResource Font.Body}"
             FontSize="{StaticResource Font.Size.Body}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="Login.FieldLabel" TargetType="controls:TrackedTextBlock" BasedOn="{StaticResource Display.Label}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--
            The form takes a share of the width rather than a fixed 560. Min/Max keep it
            readable: it never gets narrower than the fields need, and never stretches into a
            full-width band of whitespace on an ultrawide display. The artwork takes the rest.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="480" MaxWidth="720"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Form ===================== -->

        <ScrollViewer Grid.Column="0"
                      Style="{StaticResource ScrollViewer.Thin}">
            <StackPanel VerticalAlignment="Center" Margin="64,48">

                <controls:Eyebrow Text="ACCESS" Margin="0,0,0,22"/>

                <controls:TrackedTextBlock Style="{StaticResource Display.Hero}"
                                           FontSize="{DynamicResource Font.Size.DisplayLarge}"
                                           Text="WELCOME BACK"
                                           Margin="0,0,0,8"/>

                <TextBlock Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Text.Dim}"
                           Text="Sign in to your account."
                           Margin="0,0,0,34"/>

                <controls:TrackedTextBlock Style="{StaticResource Login.FieldLabel}" Text="USERNAME"/>
                <TextBox Style="{StaticResource TextBox.Field}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,20"/>

                <controls:TrackedTextBlock Style="{StaticResource Login.FieldLabel}" Text="PASSWORD"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource PasswordBox.Field}"
                             Margin="0,0,0,26"/>

                <Button Style="{StaticResource Button.Cta}"
                        Content="LOGIN"
                        Padding="15"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        IsDefault="True"
                        IsEnabled="{Binding CanLogin}"/>

                <TextBlock Style="{StaticResource Text.Body}"
                           FontSize="{DynamicResource Font.Size.BodySmall}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0">
                    <Run Text="Don't have an account? "/>
                    <Run Text="Sign up now"
                         FontWeight="Bold"
                         Foreground="{StaticResource Brush.Accent.Gold}"
                         TextDecorations="Underline"
                         MouseDown="RegisterNow_MouseDown"
                         Cursor="Hand"/>
                </TextBlock>

                <!-- OR divider -->
                <Grid Margin="0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center"
                               Fill="{StaticResource Brush.Border.Default}"/>
                    <controls:TrackedTextBlock Grid.Column="1"
                                               Style="{StaticResource Display.Label}"
                                               Foreground="{StaticResource Brush.Text.Faint}"
                                               FontSize="{DynamicResource Font.Size.Meta}"
                                               Text="OR"
                                               Margin="16,0"/>
                    <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                               Fill="{StaticResource Brush.Border.Default}"/>
                </Grid>

                <Button Style="{StaticResource Button.Ghost}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsDiscordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding ContinueWithDiscordCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Battlegrounds;component/Assets/IdP_discord.png"
                               Width="{DynamicResource Size.Icon.S}" Height="{DynamicResource Size.Icon.S}" Margin="0,0,12,0"/>
                        <TextBlock Text="Continue with Discord"
                                   FontSize="{DynamicResource Font.Size.BodySmall}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding ContinueWithSteamCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Battlegrounds;component/Assets/IdP_steam.png"
                               Width="{DynamicResource Size.Icon.S}" Height="{DynamicResource Size.Icon.S}" Margin="0,0,12,0"/>
                        <TextBlock Text="Continue with Steam"
                                   FontSize="{DynamicResource Font.Size.BodySmall}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Style="{StaticResource Text.Error}"
                           Text="{Binding ErrorMessage}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Artwork ===================== -->

        <Grid Grid.Column="1" Background="{StaticResource Brush.Surface.Window}">

            <Image Source="pack://application:,,,/Battlegrounds;component/Assets/auth.jpg"
                   Stretch="UniformToFill"/>

            <!-- Fades the photo into the form column so the seam does not read as an edge. -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource Color.Base.900}" Offset="0"/>
                        <GradientStop Color="{StaticResource Color.Scrim.Fade.Mid}" Offset="0.3"/>
                        <GradientStop Color="{StaticResource Color.Scrim.Fade.End}" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360"
                    Margin="0,0,44,0"
                    Padding="28,26"
                    Background="{StaticResource Brush.Surface.Overlay}"
                    BorderBrush="{StaticResource Brush.Action.Primary}"
                    BorderThickness="{StaticResource Stroke.EdgeLeft}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Brush.Text.Primary}"
                               FontFamily="{StaticResource Font.Heading}"
                               FontStyle="Italic"
                               FontSize="{DynamicResource Font.Size.Heading}"
                               LineHeight="28"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Text="&quot;In the chaos of battle, when the ground shakes and the sky's aflame, remember that the ultimate victory belongs to those who remain true to their purpose.&quot;"/>
                    <controls:TrackedTextBlock Style="{StaticResource Display.Label}"
                                               Foreground="{StaticResource Brush.Accent.Gold}"
                                               FontSize="{DynamicResource Font.Size.Meta}"
                                               Tracking="{StaticResource Track.Wider}"
                                               Text="— COMPANY OF HEROES BATTLEGROUNDS"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
