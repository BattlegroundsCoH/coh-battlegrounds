<UserControl x:Class="Battlegrounds.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
        Height="{StaticResource DEFAULT_APP_HEIGHT}" 
        Width="{StaticResource DEFAULT_APP_WIDTH}"
            Background="{StaticResource BackgroundAuthDarkBrush}" 
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition MaxWidth="600"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border 
            Grid.Column="0"
            CornerRadius="8" 
            BorderBrush="{StaticResource BackgroundLightBlueBrush}"
            BorderThickness="1">

            <Grid Margin="30" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo/Title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,40" HorizontalAlignment="Left">
                    <TextBlock Text="BATTLEGROUNDS" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource ForegroundWhiteBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sign into your account" 
                               FontSize="18" 
                               Foreground="{StaticResource ForegroundLightGrayBrush}"
                               HorizontalAlignment="Left"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Username Input -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="EMAIL" 
                               FontSize="12" 
                               Foreground="{StaticResource ForegroundGrayBrush}" 
                               Margin="0,0,0,8"/>
                    <Border Background="{StaticResource BackgroundAuthDarkBrush}" 
                            CornerRadius="4" 
                            BorderBrush="{StaticResource ForegroundWhiteBrush}" 
                            BorderThickness="0.25">
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="10,12" 
                                 Foreground="{StaticResource ForegroundWhiteBrush}"
                                 CaretBrush="{StaticResource ForegroundWhiteBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Password Input -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="PASSWORD" 
                               FontSize="12" 
                               Foreground="{StaticResource ForegroundGrayBrush}" 
                               Margin="0,0,0,8"/>
                    <Border Background="{StaticResource BackgroundAuthDarkBrush}" 
                            CornerRadius="4" 
                            BorderBrush="{StaticResource ForegroundWhiteBrush}" 
                            BorderThickness="0.25">
                        <PasswordBox x:Name="PasswordBox"
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Padding="10,12" 
                                     Foreground="{StaticResource ForegroundWhiteBrush}"
                                     CaretBrush="{StaticResource ForegroundWhiteBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Spacer -->
                <Grid Grid.Row="3"/>

                <!-- Login Button -->
                <Button Grid.Row="4" 
                        Content="LOGIN" 
                        Style="{StaticResource AuthButton}"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        IsDefault="True"
                        IsEnabled="{Binding CanLogin}"/>

                <TextBlock 
                    Grid.Row="5"
                    Foreground="{StaticResource ForegroundLightGrayBrush}" 
                    HorizontalAlignment="Center" 
                    Margin="0,4,0,0">
                    
                    <Run 
                        Text="Don't have an account? "/>
                    <Run 
                        Text="Sign up now"
                        FontWeight="Bold"
                        TextDecorations="Underline"
                        Cursor="Hand"/>

                </TextBlock>

                <!-- Or with horizontal lines -->
                <Grid 
                    Grid.Row="6" 
                    VerticalAlignment="Center" 
                    Margin="0,20,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Separator Margin="0,0,10,0" VerticalAlignment="Center"
                               Height="0.5"
                               Grid.Column="0"/>
                    <TextBlock Text="OR"
                               Foreground="{StaticResource ForegroundLightGrayBrush}"
                               VerticalAlignment="Center"
                               Grid.Column="1"/>
                    <Separator Margin="10,0,0,0" VerticalAlignment="Center"
                               Height="0.5"
                               Grid.Column="2"/>
                </Grid>

                <Button
                    Margin="0,10,0,0"
                    Style="{StaticResource AuthButton}"
                    Grid.Row="7"
                    Command="{Binding ContinueWithDiscordCommand}">

                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Battlegrounds;component/Assets/IdP_discord.png" 
                               Width="24" 
                               Height="24" 
                               Margin="0,0,8,0"/>
                        <TextBlock Text="Continue with Discord" 
                                   FontSize="12" 
                                   Foreground="{StaticResource ForegroundLightGrayBrush}" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Steam login (Currently not supported) -->
                <Button
                    Style="{StaticResource AuthButton}"
                    Margin="0,10,0,0"
                    Grid.Row="8"
                    Command="{Binding ContinueWithSteamCommand}"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <Image 
                            Source="pack://application:,,,/Battlegrounds;component/Assets/IdP_steam.png" 
                            Width="24" 
                            Height="24" 
                            Margin="0,0,8,0"/>
                        <TextBlock 
                            Text="Continue with Steam" 
                            FontSize="12" 
                            Foreground="{StaticResource ForegroundLightGrayBrush}" 
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Error Message -->
                <TextBlock Grid.Row="9" 
                           Text="{Binding ErrorMessage}" 
                           Foreground="{StaticResource AccentRedBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="16"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            </Grid>
        </Border>

        <Grid Grid.Column="1" 
              Background="{StaticResource BackgroundDeepBlueBrush}" >

            <Image Source="pack://application:,,,/Battlegrounds;component/Assets/auth.jpg" 
                   Stretch="Fill"/>

            <Grid 
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                <Border 
                    Background="Black"
                    Opacity="0.5">
                </Border>

                <TextBlock 
                    FontSize="24" 
                    FontWeight="Bold" 
                    Foreground="{StaticResource ForegroundWhiteBrush}" 
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="15"
                    MaxWidth="500"
                    TextWrapping="WrapWithOverflow">
                    <Italic> "In the chaos of battle, when the ground shakes
                    and the sky's aflame, remember that the ultimate
                    victory belongs to those who remain true
                    to their purpose"</Italic>
                    <LineBreak/>                    
                    <LineBreak/>
                    - Company of Heroes: Battlegrounds
                </TextBlock>
            </Grid>

        </Grid>

    </Grid>
</UserControl>