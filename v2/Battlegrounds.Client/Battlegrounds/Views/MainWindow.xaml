<Window x:Class="Battlegrounds.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Battlegrounds"
        xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
        xmlns:converters="clr-namespace:Battlegrounds.Converters"
        xmlns:views="clr-namespace:Battlegrounds.Views"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        Background="{StaticResource BackgroundDeepBlueBrush}"
        mc:Ignorable="d"
        Title="MainWindow"
        WindowStartupLocation="CenterOwner"
        MaxHeight="{StaticResource DEFAULT_APP_HEIGHT}"
        MaxWidth="{StaticResource DEFAULT_APP_WIDTH}"
        Height="{StaticResource DEFAULT_APP_HEIGHT}" 
        Width="{StaticResource DEFAULT_APP_WIDTH}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>

        <Grid Visibility="{Binding UserViewModel.IsAuthenticated, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <views:LoginView DataContext="{Binding LoginViewModel}"/>
        </Grid>
        
        <Grid Visibility="{Binding UserViewModel.IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Grid Grid.Row="0" Background="{StaticResource BackgroundBlueBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Logo/Name -->
                <TextBlock Text="BATTLEGROUNDS" 
                   Margin="20,0,0,0" 
                   VerticalAlignment="Center"
                       Foreground="{StaticResource ForegroundWhiteBrush}"
                   FontSize="24"
                   FontWeight="Bold"/>

                <!-- User Profile Section -->
                <ToggleButton x:Name="ProfileToggle"
                              Grid.Column="2"
                              HorizontalAlignment="Right"
                              Margin="0,0,10,0"
                              Cursor="Hand"
                              FocusVisualStyle="{x:Null}"
                              Background="Transparent"
                              BorderThickness="0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ProfileBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="36" Height="36" Margin="0,0,10,0">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="pack://application:,,,/Battlegrounds;component/Assets/dummy_avatar.png"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding UserViewModel.LocalUser.UserDisplayName}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource ForegroundWhiteBrush}"
                                               Margin="0,0,8,0"/>
                                    <Path x:Name="Chevron"
                                          Data="M0,0 L4,4 L8,0"
                                          Stroke="{StaticResource ForegroundLightGrayBrush}"
                                          StrokeThickness="1.5"
                                          VerticalAlignment="Center"
                                          Margin="0,2,0,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ProfileBorder" Property="Background" Value="{StaticResource BackgroundLightBlueBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ProfileBorder" Property="Background" Value="{StaticResource BackgroundLightBlueBrush}"/>
                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- Profile Dropdown Popup -->
                <Popup x:Name="ProfilePopup"
                       Grid.Column="2"
                       IsOpen="{Binding IsChecked, ElementName=ProfileToggle}"
                       PlacementTarget="{Binding ElementName=ProfileToggle}"
                       Placement="Custom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{StaticResource BackgroundDarkBlueBrush}"
                            BorderBrush="{StaticResource BackgroundLightGrayBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinWidth="200"
                            Margin="8,0,8,8"
                            Padding="0,6">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Profile header -->
                            <StackPanel Margin="14,8,14,10">
                                <TextBlock Text="{Binding UserViewModel.LocalUser.UserDisplayName}"
                                           Foreground="{StaticResource ForegroundWhiteBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                            </StackPanel>
                            <Separator Background="{StaticResource BackgroundLightGrayBrush}" Margin="10,0,10,4"/>

                            <Button Style="{StaticResource ProfileMenuItemButton}"
                                    Content="⚙  Settings"
                                    Command="{Binding SettingsCommand}"
                                    Click="SettingsButton_Click"/>
                            <Button Style="{StaticResource ProfileMenuItemButton}"
                                    Content="👤  Profile"
                                    IsEnabled="False"/>
                            <Separator Background="{StaticResource BackgroundLightGrayBrush}" Margin="10,4"/>
                            <Button Style="{StaticResource ProfileMenuItemButton}"
                                    Content="🚪  Log Out"
                                    Command="{Binding LogoutCommand}"
                                    Click="LogOutButton_Click"
                                    Foreground="{StaticResource ForegroundLightRedBrush}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="20" Visibility="{Binding HasMainContent, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Menu -->
                <StackPanel Margin="0,4,0,0">
                    <RadioButton x:Name="HomeButton" Style="{StaticResource NavigationButton}" Content="Home" Margin="0,0,0,10" IsChecked="True"/>
                    <RadioButton x:Name="CompaniesButton" Style="{StaticResource NavigationButton}" Content="Companies" Margin="0,0,0,10"/>
                    <RadioButton x:Name="MultiplayerButton" Style="{StaticResource NavigationButton}" Content="Multiplayer" Margin="0,0,0,10"/>
                    <RadioButton Style="{StaticResource NavigationButton}" Content="Single Player" Margin="0,0,0,10" Command="{Binding SingleplayerCommand}" />
                </StackPanel>

                <!-- Content Presenter -->
                <ContentPresenter Grid.Column="1" x:Name="MainContent">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=HomeButton, Path=IsChecked}" Value="True">
                                    <Setter Property="Content" Value="{Binding HomeView}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=MultiplayerButton, Path=IsChecked}" Value="True">
                                    <Setter Property="Content" Value="{Binding MultiplayerView}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=CompaniesButton, Path=IsChecked}" Value="True">
                                    <Setter Property="Content" Value="{Binding CompanyBrowserView}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </Grid>

            <Grid Grid.Row="1" Margin="20" Visibility="{Binding HasMainContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ContentPresenter>
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Content" Value="{Binding CurrentContent}"/>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </Grid>


            <!-- Modal Content Area -->
            <Grid 
            Grid.Row="1"
            Visibility="{Binding HasDialog, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Hidden}"
            Background="#FF000000">
                <ContentPresenter
                Content="{Binding DialogContent}"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Width" Value="400"/>
                            <Setter Property="Height" Value="300"/>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </Grid>

        </Grid>
    </Grid>
</Window>
