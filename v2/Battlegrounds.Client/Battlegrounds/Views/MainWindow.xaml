<Window x:Class="Battlegrounds.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Battlegrounds"
        xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
        xmlns:converters="clr-namespace:Battlegrounds.Converters"
        xmlns:views="clr-namespace:Battlegrounds.Views"
        xmlns:controls="clr-namespace:Battlegrounds.Controls"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        Background="{StaticResource Brush.Surface.Window}"
        FontFamily="{StaticResource Font.Body}"
        FontSize="{DynamicResource Font.Size.Body}"
        controls:Responsive.IsBreakpointHost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        mc:Ignorable="d"
        Title="MainWindow"
        WindowStartupLocation="CenterScreen"
        Height="{StaticResource Size.Window.DefaultHeight}"
        Width="{StaticResource Size.Window.DefaultWidth}">
    <!--
        Width/Height above use StaticResource on purpose: they are the startup size only. A live
        UI-scale change resizes the window proportionally in code (MainWindow.xaml.cs) rather than
        snapping it to the new scale's default. Everything else here scales dynamically.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>

        <Grid Visibility="{Binding UserViewModel.IsAuthenticated, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <views:LoginView DataContext="{Binding LoginViewModel}"/>
        </Grid>
        
        <Grid Visibility="{Binding UserViewModel.IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- Main Content Area -->
            <Grid Margin="{DynamicResource Space.XL}" Visibility="{Binding HasMainContent, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--
                    Navigation rail. The logo heads it, the primary destinations sit at the top and
                    SETTINGS is pinned to the bottom. GroupName is required, not decorative: WPF
                    scopes RadioButton exclusion to the parent container, so the two StackPanels
                    would otherwise each keep their own checked item.
                -->
                <!--
                    The rail narrows on a Compact window so the content area keeps its room. The
                    labels are TrackedTextBlocks and cannot wrap or trim, so Size.NavRailCompact
                    stays wide enough for "SINGLE PLAYER" at every UI scale rather than relying on
                    the text to reflow.
                -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Width" Value="{DynamicResource Size.NavRail}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding (controls:Responsive.Breakpoint), RelativeSource={RelativeSource Self}}" Value="Compact">
                                    <Setter Property="Width" Value="{DynamicResource Size.NavRailCompact}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0"
                           Source="pack://application:,,,/Battlegrounds;component/Assets/BattlegroundsLogo.png"
                           MaxWidth="{DynamicResource Size.NavLogo}"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           Margin="16,4,16,28"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <RadioButton x:Name="HomeButton" GroupName="MainNav" Style="{StaticResource Button.Nav}" Content="HOME" Margin="0,0,0,10" IsChecked="{Binding IsHomeButtonActive}"/>
                        <RadioButton x:Name="CompaniesButton" GroupName="MainNav" Style="{StaticResource Button.Nav}" Content="COMPANIES" Margin="0,0,0,10"/>
                        <RadioButton x:Name="MultiplayerButton" GroupName="MainNav" Style="{StaticResource Button.Nav}" Content="MULTIPLAYER" Margin="0,0,0,10" IsChecked="{Binding IsMultiplayerButtonActive}"/>
                        <RadioButton GroupName="MainNav" Style="{StaticResource Button.Nav}" Content="SINGLE PLAYER" Margin="0,0,0,10" Command="{Binding SingleplayerCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Separator Background="{StaticResource Brush.Border.Hairline}" Margin="0,0,0,10"/>
                        <RadioButton x:Name="SettingsButton" GroupName="MainNav" Style="{StaticResource Button.Nav}" Content="SETTINGS"/>
                    </StackPanel>
                </Grid>

                <!-- Content Presenter -->
                <ContentPresenter Grid.Column="1" x:Name="MainContent" Margin="20,0,0,0">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=HomeButton, Path=IsChecked}" Value="True">
                                    <Setter Property="Content" Value="{Binding HomeView}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=MultiplayerButton, Path=IsChecked}" Value="True">
                                    <Setter Property="Content" Value="{Binding MultiplayerView}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=CompaniesButton, Path=IsChecked}" Value="True">
                                    <Setter Property="Content" Value="{Binding CompanyBrowserView}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=SettingsButton, Path=IsChecked}" Value="True">
                                    <Setter Property="Content" Value="{Binding SettingsView}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </Grid>

            <Grid Margin="{DynamicResource Space.XL}" Visibility="{Binding HasMainContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ContentPresenter>
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Content" Value="{Binding CurrentContent}"/>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </Grid>


            <!--
                Modal Content Area.

                The host bounds the dialog rather than sizing it. It used to set Width="400" and
                MinHeight="300" on every dialog, which squeezed the company-creation wizard —
                authored at 800 wide — into a 400px column. Each modal now declares its own
                MinWidth/MaxWidth and the ScrollViewer keeps a tall one reachable instead of
                clipping it against the window edge.
            -->
            <Grid
            Visibility="{Binding HasDialog, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Hidden}"
            Background="{StaticResource Brush.Surface.Scrim}">
                <ScrollViewer Style="{StaticResource ScrollViewer.Thin}"
                              Margin="{DynamicResource Space.Page}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ContentPresenter
                        Content="{Binding DialogContent}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Window>
