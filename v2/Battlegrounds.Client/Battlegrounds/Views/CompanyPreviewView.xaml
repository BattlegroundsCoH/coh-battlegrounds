<UserControl x:Class="Battlegrounds.Views.CompanyPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
             xmlns:converters="clr-namespace:Battlegrounds.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CompanyPreviewViewModel}"
             d:DesignHeight="550" d:DesignWidth="820">

    <UserControl.Resources>
        <converters:FactionIconMultiBindingConverter x:Key="FactionIconConverter"/>
        <converters:FactionIdToNameConverter x:Key="FactionIdToNameConverter"/>
        <converters:BlueprintIconMultiBindingConverter x:Key="BlueprintIconMultiConverter"/>
        <converters:BlueprintSymbolMultiBindingConverter x:Key="BlueprintSymbolMultiConverter"/>
        <converters:BlueprintNameConverter x:Key="BlueprintNameConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>

        <!-- Reusable squad item template matching the CompanyEditorView style -->
        <DataTemplate x:Key="PreviewSquadTemplate">
            <Border Padding="8,6"
                    Margin="0,2"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Unit Icon -->
                    <Image Grid.Column="0"
                           Width="28" Height="28"
                           Margin="0,0,8,0">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                <Binding Path="Blueprint"/>
                                <Binding Path="DataContext.GameId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </Image.Source>
                    </Image>

                    <!-- Unit Name -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Blueprint, Converter={StaticResource BlueprintNameConverter}}"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Upgrade icons -->
                    <ItemsControl Grid.Column="2"
                                  ItemsSource="{Binding Upgrades}"
                                  Margin="4,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Width="20" Height="20" Margin="0,0,2,0">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource BlueprintSymbolMultiConverter}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext.GameId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Transport icon -->
                    <Image Grid.Column="3"
                           Width="20" Height="20"
                           Margin="2,0,0,0"
                           Visibility="{Binding HasTransport, Converter={StaticResource BooleanToVisibility}}">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource BlueprintSymbolMultiConverter}">
                                <Binding Path="Transport.TransportBlueprint"/>
                                <Binding Path="DataContext.GameId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Surface.Sunken}"
            BorderBrush="{StaticResource Brush.Border.Hairline}"
            BorderThickness="1"
            CornerRadius="0"
            Width="820"
            MaxHeight="550">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Company Info Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Faction Icon + Company Name -->
                <StackPanel Orientation="Horizontal">
                    <Image Width="36" Height="36" VerticalAlignment="Center">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource FactionIconConverter}">
                                <Binding Path="Faction"/>
                                <Binding Path="GameId"/>
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CompanyName}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Primary}"/>
                        <TextBlock Foreground="{StaticResource Brush.Text.Dim}" FontSize="12">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource FactionIdToNameConverter}">
                                    <Binding Path="Faction"/>
                                    <Binding Path="GameId"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Squad Count -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total Squads: "
                               Foreground="{StaticResource Brush.Text.Dim}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SquadCount}"
                               Foreground="{StaticResource Brush.Accent.Gold}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Phase Columns -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Starting Units -->
                <Border Grid.Column="0"
                        Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Margin="0,0,4,0"
                        Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6">
                            <Run Text="Starting ("/>
                            <Run Text="{Binding StartingUnits.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Thin}">
                            <ItemsControl ItemsSource="{Binding StartingUnits}"
                                          ItemTemplate="{StaticResource PreviewSquadTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Skirmish Units -->
                <Border Grid.Column="1"
                        Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Margin="4,0"
                        Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6">
                            <Run Text="Skirmish ("/>
                            <Run Text="{Binding SkirmishUnits.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Thin}">
                            <ItemsControl ItemsSource="{Binding SkirmishUnits}"
                                          ItemTemplate="{StaticResource PreviewSquadTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Battle Units -->
                <Border Grid.Column="2"
                        Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Margin="4,0"
                        Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6">
                            <Run Text="Battle ("/>
                            <Run Text="{Binding BattleUnits.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Thin}">
                            <ItemsControl ItemsSource="{Binding BattleUnits}"
                                          ItemTemplate="{StaticResource PreviewSquadTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Reserves Units -->
                <Border Grid.Column="3"
                        Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Margin="4,0,0,0"
                        Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6">
                            <Run Text="Reserves ("/>
                            <Run Text="{Binding ReservesUnits.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Thin}">
                            <ItemsControl ItemsSource="{Binding ReservesUnits}"
                                          ItemTemplate="{StaticResource PreviewSquadTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Close Button -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="Close"
                        Width="100"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
