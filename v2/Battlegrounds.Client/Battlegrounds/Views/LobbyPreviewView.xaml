<UserControl x:Class="Battlegrounds.Views.LobbyPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Battlegrounds.Converters"
             xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:MultiplayerViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="340">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <converters:FactionIconMultiBindingConverter x:Key="FactionIconConverter"/>
        <converters:FactionIdToNameConverter x:Key="FactionNameConverter"/>
        <converters:ScenarioIdToNameConverter x:Key="ScenarioIdToNameConverter"/>

        <!-- Slot card shown in the team composition grid -->
        <DataTemplate x:Key="SlotCardTemplate">
            <Border Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Height="44"
                    Margin="0,0,0,4">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Faction icon when slot is occupied -->
                    <Image Width="28" Height="28"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource FactionIconConverter}">
                                <Binding Path="Faction"/>
                                <Binding Path="GameId"/>
                            </MultiBinding>
                        </Image.Source>
                    </Image>

                    <!-- Lock icon when slot is locked and unoccupied -->
                    <TextBlock Text="🔒"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Slot label -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0">
                        <TextBlock FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                            <Setter Property="Text" Value="{Binding Name}"/>
                                            <Setter Property="FontWeight" Value="DemiBold"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Body}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOccupied}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <TextBlock 
                               FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Open"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Dim}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                            <Setter Property="Text">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource FactionNameConverter}">
                                                        <Binding Path="Faction"/>
                                                        <Binding Path="GameId"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="FontSize" Value="8"/>
                                            <Setter Property="FontStyle" Value="Oblique"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Dim}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                            <Setter Property="Text" Value="Locked"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Faint}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Settings row -->
        <DataTemplate x:Key="SettingRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource Brush.Text.Dim}"
                           FontSize="12"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Value}"
                           Foreground="{StaticResource Brush.Accent.Gold}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Surface.Sunken}"
            BorderBrush="{StaticResource Brush.Border.Hairline}"
            BorderThickness="1"
            CornerRadius="0">

        <!-- No lobby selected placeholder -->
        <Grid>
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding HasSelectedLobby, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                <TextBlock Text="📋"
                           FontSize="40"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="Select a lobby"
                           Foreground="{StaticResource Brush.Text.Dim}"
                           FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Lobby preview -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasSelectedLobby, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="14">

                    <!-- Map preview image -->
                    <Border CornerRadius="0"
                            Height="280"
                            Margin="0,0,0,14"
                            ClipToBounds="True"
                            Background="{StaticResource Brush.Surface.Card}">
                        <Image Source="{Binding SelectedLobbyMapPreview}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <!-- Lobby name and host -->
                    <TextBlock Text="{Binding SelectedLobby.Name}"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               FontSize="16"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Host: "
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding SelectedLobby.Host}"
                                   Foreground="{StaticResource Brush.Accent.Gold}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text=" · "
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding SelectedLobby.Players, StringFormat='{}{0} players'}"
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   FontSize="12"/>
                        <TextBlock Text=" · 🔒"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   Visibility="{Binding SelectedLobby.IsPasswordProtected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Separator Background="{StaticResource Brush.Border.Hairline}" Margin="0,12"/>

                    <!-- Team composition -->
                    <TextBlock Text="TEAM COMPOSITION"
                               Foreground="{StaticResource Brush.Text.Dim}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Team 1 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TEAM 1"
                                       Foreground="{StaticResource Brush.Accent.Gold}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <!-- Slots when available -->
                            <ItemsControl ItemsSource="{Binding SelectedLobby.Team1Slots}"
                                          ItemTemplate="{StaticResource SlotCardTemplate}"
                                          Visibility="{Binding SelectedLobby.Team1Slots.Length, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                            <!-- Fallback when no slot data available -->
                            <TextBlock Text="No slot data"
                                       Foreground="{StaticResource Brush.Text.Dim}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLobby.Team1Slots.Length}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Team 2 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TEAM 2"
                                       Foreground="{StaticResource Brush.Status.Danger}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding SelectedLobby.Team2Slots}"
                                          ItemTemplate="{StaticResource SlotCardTemplate}"
                                          Visibility="{Binding SelectedLobby.Team2Slots.Length, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                            <!-- Fallback when no slot data available -->
                            <TextBlock Text="No slot data"
                                       Foreground="{StaticResource Brush.Text.Dim}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLobby.Team2Slots.Length}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Separator -->
                    <Separator Background="{StaticResource Brush.Border.Hairline}" Margin="0,12"/>

                    <!-- Lobby settings -->
                    <TextBlock Text="SETTINGS"
                               Foreground="{StaticResource Brush.Text.Dim}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <!-- Always-visible map + mode rows -->
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Map"
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   FontSize="12"/>
                        <TextBlock Grid.Column="1"
                                   Foreground="{StaticResource Brush.Accent.Gold}"
                                   FontSize="12"
                                   FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource ScenarioIdToNameConverter}">
                                    <Binding Path="SelectedLobby.Map"/>
                                    <Binding Path="SelectedLobby.Game"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Game Mode"
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   FontSize="12"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedLobby.GameMode}"
                                   Foreground="{StaticResource Brush.Accent.Gold}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Extra settings from server -->
                    <ItemsControl ItemsSource="{Binding SelectedLobby.Settings}"
                                  ItemTemplate="{StaticResource SettingRowTemplate}"/>

                    <!-- Join button -->
                    <Button Content="Join Lobby"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding JoinLobbyCommand}"
                            IsEnabled="{Binding SelectedLobby.CanJoin}"
                            Height="40"
                            FontSize="14"
                            Margin="0,16,0,0"/>

                    <TextBlock Text="🔒  Password required"
                               Foreground="{StaticResource Brush.Text.Dim}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Visibility="{Binding SelectedLobby.IsPasswordProtected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="Lobby is full"
                               Foreground="{StaticResource Brush.Status.DangerText}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLobby.CanJoin}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
