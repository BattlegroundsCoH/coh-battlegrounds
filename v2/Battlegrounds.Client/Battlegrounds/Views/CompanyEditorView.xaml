<UserControl x:Class="Battlegrounds.Views.CompanyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Battlegrounds.Views"
             xmlns:vm="clr-namespace:Battlegrounds.ViewModels"
             xmlns:bp="clr-namespace:Battlegrounds.Models.Blueprints"
             xmlns:converters="clr-namespace:Battlegrounds.Converters"
             xmlns:c="clr-namespace:Battlegrounds.Models.Companies"
             xmlns:e="clr-namespace:Battlegrounds.Rendering.Effects"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:CompanyEditorViewModel}">

    <UserControl.Resources>

        <converters:BlueprintNameConverter x:Key="BlueprintNameConverter"/>
        <converters:BlueprintBriefTextConverter x:Key="BlueprintBriefTextConverter"/>
        <converters:BlueprintHelpTextConverter x:Key="BlueprintHelpTextConverter"/>
        <converters:BlueprintIconConverter x:Key="BlueprintIconConverter"/>
        <converters:BlueprintIconMultiBindingConverter x:Key="BlueprintIconMultiConverter"/>
        <converters:BlueprintSymbolMultiBindingConverter x:Key="BlueprintSymbolMultiConverter"/>
        <converters:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <converters:NullVisibilityConverter x:Key="NotNullVisibilityConverter" IsInverted="True"/>
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <converters:RankStarColourConverter x:Key="RankStarColourConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:FactionIconMultiBindingConverter x:Key="FactionIconConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <converters:BoolToItemType x:Key="BoolToItemType"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>

        <DataTemplate x:Key="AvailableUnitTemplate">
            <Button Command="{Binding DataContext.SetSelectedSquadCommand, 
            RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            x:Name="UnitBorder"
                            Padding="12,8"
                            Margin="{DynamicResource Space.XS}"
                            Width="320"
                            Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Unit Icon -->
                                <Image 
                                    Grid.Column="0"
                                    Width="{DynamicResource Size.Icon.L}"
                                    Height="{DynamicResource Size.Icon.L}"
                                    Margin="0,0,12,0">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>

                                <!-- Unit Name -->
                                <TextBlock Grid.Column="1"
                                 Foreground="{StaticResource Brush.Text.Primary}"
                                 VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <Binding Path="." Converter="{StaticResource BlueprintNameConverter}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UnitBorder" Property="Background" Value="{StaticResource Brush.Border.Hairline}"/>
                                <Setter TargetName="UnitBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UnitBorder" Property="Background" Value="{StaticResource Brush.Surface.Sunken}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CompanyUnitTemplate">
            <Button 
                Command="{Binding DataContext.SetSelectedSquadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            x:Name="UnitBorder"
                            Padding="12,8"
                            Margin="{DynamicResource Space.XS}"
                            Width="280"
                            Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="0">
                            <StackPanel>

                                <!-- Main unit row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Unit Icon -->
                                    <Image 
                                        Grid.Column="0"
                                        Width="{DynamicResource Size.Icon.L}"
                                        Height="{DynamicResource Size.Icon.L}"
                                        Margin="0,0,12,0">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                                <Binding Path="Blueprint"/>
                                                <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>

                                    <!-- Unit Name (and ID) -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock 
                                            Foreground="{StaticResource Brush.Text.Primary}"
                                            VerticalAlignment="Center">
                                            <Run Text="{Binding Blueprint, Converter={StaticResource BlueprintNameConverter}, Mode=OneWay}"/> (#<Run Text="{Binding Id, Mode=OneWay}"/>)
                                        </TextBlock>
                                        <!-- Custom Name (if any)-->
                                        <TextBlock 
                                            FontStyle="Italic"
                                            Visibility="{Binding HasCustomName, Converter={StaticResource BooleanToVisibility}}"
                                            Foreground="{StaticResource Brush.Text.Primary}"
                                            VerticalAlignment="Center">
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Unit upgrades -->
                                    <StackPanel
                                        Grid.Column="2">
                                        <ItemsControl 
                                            ItemsSource="{Binding Upgrades}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image 
                                                        Width="{DynamicResource Size.Icon.M}"
                                                        Height="{DynamicResource Size.Icon.M}"
                                                        Margin="0,0,4,0">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource BlueprintSymbolMultiConverter}">
                                                                <Binding Path="."/>
                                                                <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl 
                                            ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image 
                                                        Width="{DynamicResource Size.Icon.M}"
                                                        Height="{DynamicResource Size.Icon.M}"
                                                        Margin="0,0,4,0">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource BlueprintSymbolMultiConverter}">
                                                                <Binding Path="EntityBlueprint"/>
                                                                <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Unit transport -->
                                    <Image 
                                        Width="{DynamicResource Size.Icon.M}"
                                        Height="{DynamicResource Size.Icon.M}"
                                        Margin="0,0,4,0"
                                        Grid.Column="3"
                                        Visibility="{Binding HasTransport, Converter={StaticResource BooleanToVisibility}}">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource BlueprintSymbolMultiConverter}">
                                                <Binding Path="Transport.TransportBlueprint"/>
                                                <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Grid>

                                <!-- Passenger row — only visible when this unit carries a passenger -->
                                <StackPanel Visibility="{Binding HasPassenger, Converter={StaticResource BooleanToVisibility}}">
                                    <Border
                                        Height="1"
                                        Margin="0,5,0,5"
                                        Background="{StaticResource Brush.Border.Hairline}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Passenger Icon -->
                                        <Image 
                                            Grid.Column="0"
                                            Width="{DynamicResource Size.Icon.M}"
                                            Height="{DynamicResource Size.Icon.M}"
                                            Margin="0,0,8,0">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                                    <Binding Path="PassengerBlueprint"/>
                                                    <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <!-- Passenger Name -->
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="{DynamicResource Font.Size.Meta}"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource Brush.Text.Dim}">
                                            ↳ <Run Text="{Binding PassengerBlueprint, Converter={StaticResource BlueprintNameConverter}, Mode=OneWay}"/> (#<Run Text="{Binding PassengerId, Mode=OneWay}"/>)
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UnitBorder" Property="Background" Value="{StaticResource Brush.Border.Hairline}"/>
                                <Setter TargetName="UnitBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UnitBorder" Property="Background" Value="{StaticResource Brush.Surface.Sunken}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <Style x:Key="TransportRadioButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                        Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse 
                                    x:Name="RadioOuter"
                                    Width="{DynamicResource Size.Icon.XS}"
                                    Height="{DynamicResource Size.Icon.XS}"
                                    Stroke="{StaticResource Brush.Text.Dim}"
                                    StrokeThickness="1"
                                    Fill="Transparent"/>

                                <Ellipse 
                                    x:Name="RadioInner"
                                    Width="8"
                                    Height="8"
                                    Fill="{StaticResource Brush.Accent.Gold}"
                                    Visibility="Collapsed"/>

                                <ContentPresenter 
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioInner" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.Border.Hairline}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.Border.Hairline}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TransportItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Transport Icon -->
                <Image Grid.Column="0"
               Width="{DynamicResource Size.Icon.M}"
               Height="{DynamicResource Size.Icon.M}"
               Margin="0,0,8,0">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                            <Binding Path="."/>
                            <Binding Path="DataContext.Game" 
                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                    </Image.Source>
                </Image>

                <!-- Transport Name -->
                <TextBlock Grid.Column="1"
                   Text="{Binding Converter={StaticResource BlueprintNameConverter}}"
                   VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CapturedItemTemplate">
            <Button Command="{Binding DataContext.SetSelectedCapturedItemCommand,
            RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="UnitBorder"
                            Padding="12,8"
                            Margin="{DynamicResource Space.XS}"
                            Width="320"
                            Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Status.Caution}"
                            BorderThickness="1"
                            CornerRadius="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Item Icon -->
                                <Image
                                    Grid.Column="0"
                                    Width="{DynamicResource Size.Icon.L}"
                                    Height="{DynamicResource Size.Icon.L}"
                                    Margin="0,0,12,0">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                            <Binding Path="ItemBlueprint"/>
                                            <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>

                                <!-- Item Name -->
                                <StackPanel 
                                    Grid.Column="1"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <Binding Path="ItemBlueprint" Converter="{StaticResource BlueprintNameConverter}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock
                                        Foreground="{StaticResource Brush.Text.Body}"
                                        FontSize="{DynamicResource Font.Size.Meta}"
                                        FontStyle="Italic"
                                        VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <Binding Path="IsTeamWeapon" Converter="{StaticResource BoolToItemType}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UnitBorder" Property="Background" Value="{StaticResource Brush.Border.Hairline}"/>
                                <Setter TargetName="UnitBorder" Property="BorderBrush" Value="{StaticResource Brush.Status.Caution}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UnitBorder" Property="Background" Value="{StaticResource Brush.Surface.Sunken}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SquadItemAssignmentTemplate">
            <Button 
                Command="{Binding DataContext.AddItemToSquadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            x:Name="UnitBorder"
                            Padding="12,8"
                            Margin="{DynamicResource Space.XS}"
                            Width="280"
                            Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="0">
                            <StackPanel>

                                <!-- Main unit row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Unit Icon -->
                                    <Image 
                                        Grid.Column="0"
                                        Width="{DynamicResource Size.Icon.L}"
                                        Height="{DynamicResource Size.Icon.L}"
                                        Margin="0,0,12,0">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                                <Binding Path="Squad.Blueprint"/>
                                                <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>

                                    <!-- Unit Name (and ID) -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock 
                                Foreground="{StaticResource Brush.Text.Primary}"
                                VerticalAlignment="Center">
                                <Run Text="{Binding Squad.Blueprint, Converter={StaticResource BlueprintNameConverter}, Mode=OneWay}"/> (#<Run Text="{Binding Squad.Id, Mode=OneWay}"/>)
                                        </TextBlock>
                                        <!-- Custom Name (if any)-->
                                        <TextBlock 
                                FontStyle="Italic"
                                Visibility="{Binding Squad.HasCustomName, Converter={StaticResource BooleanToVisibility}}"
                                Foreground="{StaticResource Brush.Text.Primary}"
                                VerticalAlignment="Center">
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Unit transport -->
                                    <Image 
                                        Width="{DynamicResource Size.Icon.M}"
                                        Height="{DynamicResource Size.Icon.M}"
                                        Margin="0,0,4,0"
                                        Grid.Column="3"
                                        Visibility="{Binding Squad.HasTransport, Converter={StaticResource BooleanToVisibility}}">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource BlueprintSymbolMultiConverter}">
                                                <Binding Path="Squad.Transport.TransportBlueprint"/>
                                                <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Grid>

                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UnitBorder" Property="Background" Value="{StaticResource Brush.Border.Hairline}"/>
                                <Setter TargetName="UnitBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UnitBorder" Property="Background" Value="{StaticResource Brush.Surface.Sunken}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SquadUpgradeTemplate">
            <Button 
                Command="{Binding ApplyUpgradeCommand}"
                CommandParameter="{Binding Blueprint}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                IsEnabled="{Binding CanUpdate}"
                Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            x:Name="UpgradeBorder"
                            Margin="{DynamicResource Space.XS}"
                            Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="0">
                            <Grid>
                                <Border 
                                    x:Name="AppliedOverlay"
                                    Background="{StaticResource Brush.Status.Caution}"
                                    Opacity="0.45"
                                    CornerRadius="0"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsUpgraded, Converter={StaticResource BooleanToVisibility}}"/>
                                <Image 
                                    Grid.Column="0"
                                    Margin="2"
                                    Width="{DynamicResource Size.Icon.XL}"
                                    Height="{DynamicResource Size.Icon.XL}">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                            <Binding Path="Blueprint"/>
                                            <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UpgradeBorder" Property="Background" 
                                Value="{StaticResource Brush.Border.Hairline}"/>
                                <Setter TargetName="UpgradeBorder" Property="BorderBrush" 
                                Value="{StaticResource Brush.Accent.Gold}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UpgradeBorder" Property="Background" 
                                Value="{StaticResource Brush.Surface.Sunken}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="UpgradeBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ToolTip>

                    <ToolTip Style="{StaticResource ToolTip.Default}">
                        <StackPanel>
                            <TextBlock
                                Text="{Binding Blueprint, Converter={StaticResource BlueprintNameConverter}}"
                                FontSize="{DynamicResource Font.Size.Body}"
                                FontWeight="Bold"
                                Foreground="{StaticResource Brush.Text.Primary}"
                                Margin="0,0,0,4"/>

                            <TextBlock
                                Text="{Binding Blueprint, Converter={StaticResource BlueprintBriefTextConverter}}"
                                Foreground="{StaticResource Brush.Text.Primary}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,12"/>
                            
                            <!-- Upgrade Costs -->
                            <StackPanel 
                                Orientation="Horizontal" 
                                VerticalAlignment="Bottom" 
                                Margin="0,18,0,0"
                                Grid.Row="2">

                                <StackPanel 
                                    Orientation="Horizontal"
                                    Visibility="{Binding Blueprint.Cost.Manpower, Converter={StaticResource ZeroToVisibilityConverter}}">
                                    <Image 
                                        Width="{DynamicResource Size.Icon.M}"
                                        Height="{DynamicResource Size.Icon.M}"
                                        Source="pack://siteoforigin:,,,/Assets/Resources/coh3_manpower_small.png"/>
                                    <TextBlock 
                                        Margin="4,0,0,0"
                                        Text="{Binding Blueprint.Cost.Manpower}"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        VerticalAlignment="Center"
                                        />
                                </StackPanel>

                                <StackPanel 
                                    Orientation="Horizontal"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding Blueprint.Cost.Munitions, Converter={StaticResource ZeroToVisibilityConverter}}">
                                    <Image 
                                        Width="{DynamicResource Size.Icon.M}"
                                        Height="{DynamicResource Size.Icon.M}"
                                        Source="pack://siteoforigin:,,,/Assets/Resources/coh3_munitions_small.png"/>
                                    <TextBlock 
                                        Margin="4,0,0,0"
                                        Text="{Binding Blueprint.Cost.Munitions}"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        VerticalAlignment="Center"
                                        />
                                </StackPanel>

                                <StackPanel 
                                    Orientation="Horizontal"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding Blueprint.Cost.Fuel, Converter={StaticResource ZeroToVisibilityConverter}}">
                                    <Image 
                                        Width="{DynamicResource Size.Icon.M}"
                                        Height="{DynamicResource Size.Icon.M}"
                                        Source="pack://siteoforigin:,,,/Assets/Resources/coh3_fuel_small.png"/>
                                    <TextBlock 
                                        Margin="4,0,0,0"
                                        Text="{Binding Blueprint.Cost.Fuel}"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        VerticalAlignment="Center"
                                        />
                                </StackPanel>

                            </StackPanel>

                        </StackPanel>
                    </ToolTip>
                    
                    
                </Button.ToolTip>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SquadItemTemplate">
            <Button 
                Command="{Binding RemoveItemCommand}"
                CommandParameter="{Binding}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                IsEnabled="{Binding CanUpdate}"
                Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            x:Name="ItemBorder"
                            Margin="{DynamicResource Space.XS}"
                            Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="0">
                            <Grid>
                                <Image 
                                    Grid.Column="0"
                                    Margin="2"
                                    Width="{DynamicResource Size.Icon.XL}"
                                    Height="{DynamicResource Size.Icon.XL}">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                            <Binding Path="Blueprint"/>
                                            <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" 
                                    Value="{StaticResource Brush.Border.Hairline}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" 
                                    Value="{StaticResource Brush.Accent.Gold}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" 
                                    Value="{StaticResource Brush.Surface.Sunken}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ToolTip>

                    <ToolTip Style="{StaticResource ToolTip.Default}">
                        <StackPanel>
                            <TextBlock
                                Text="{Binding Blueprint, Converter={StaticResource BlueprintNameConverter}}"
                                FontSize="{DynamicResource Font.Size.Body}"
                                FontWeight="Bold"
                                Foreground="{StaticResource Brush.Text.Primary}"
                                Margin="0,0,0,4"/>

                            <TextBlock
                                Text="{Binding Blueprint, Converter={StaticResource BlueprintBriefTextConverter}}"
                                Foreground="{StaticResource Brush.Text.Primary}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,12"/>

                        </StackPanel>
                    </ToolTip>


                </Button.ToolTip>
            </Button>
        </DataTemplate>

    </UserControl.Resources>
    
    <Grid> <!-- No need for margin, outer container already has one -->
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Header with Lobby Name and Back Button -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="← Go Back" 
                Style="{StaticResource Button.Ghost}"
                Command="{Binding LeaveCommand}"/>

            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Display: click to begin editing -->
                <TextBlock
                    Text="{Binding CompanyName}"
                    FontSize="{DynamicResource Font.Size.PageTitle}"
                    FontWeight="Bold"
                    Foreground="{StaticResource Brush.Text.Primary}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    ToolTip="Click to rename"
                    Visibility="{Binding IsEditingName, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding BeginRenameCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>

                <!-- Edit: inline TextBox -->
                <TextBox
                    x:Name="CompanyNameTextBox"
                    Text="{Binding EditingCompanyName, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="{DynamicResource Font.Size.PageTitle}"
                    FontWeight="Bold"
                    MinWidth="200"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Brush.Text.Primary}"
                    Background="Transparent"
                    BorderBrush="{StaticResource Brush.Accent.Gold}"
                    BorderThickness="0,0,0,1"
                    CaretBrush="{StaticResource Brush.Text.Primary}"
                    SelectionBrush="{StaticResource Brush.Accent.Gold}"
                    Visibility="{Binding IsEditingName, Converter={StaticResource BooleanToVisibility}}"
                    IsVisibleChanged="CompanyNameTextBox_IsVisibleChanged"
                    KeyDown="CompanyNameTextBox_KeyDown"
                    LostFocus="CompanyNameTextBox_LostFocus"/>

            </Grid>

            <Grid 
                Width="320"
                Grid.Column="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="0"
                        HorizontalAlignment="Right"
                            Margin="0,0,8,0">

                    <Image
                        Width="{DynamicResource Size.Icon.XS}"
                        Height="{DynamicResource Size.Icon.XS}"
                        Margin="0,0,8,0"
                        Visibility="{Binding IsDoctrineDirty, Converter={StaticResource BooleanToVisibility}}"
                        Source="pack://siteoforigin:,,,/Assets/Misc/mission_icon_warning.png"/>

                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.Text.Primary}"
                        Text="{Binding DoctrineName}"/>

                </StackPanel>
                
                <Image 
                    Width="{DynamicResource Size.Icon.L}" 
                    Height="{DynamicResource Size.Icon.L}"
                    Grid.Column="1">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource FactionIconConverter}">
                            <Binding Path="Faction"/>
                            <Binding Path="Game"/>
                        </MultiBinding>
                    </Image.Source>
                </Image>
            </Grid>
            

        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">

            <!--
                The sidebar takes a share of the width rather than a flat 330, so extra width on a
                large window is split with the unit grid instead of all landing on the left.
            -->
            <Grid.ColumnDefinitions>
                <!-- Main Content -->
                <ColumnDefinition Width="3*"/>
                <!-- Right sidebar-->
                <ColumnDefinition Width="*" MinWidth="330" MaxWidth="480"/>

            </Grid.ColumnDefinitions>

            <!-- Company Composition Editor -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="36"/> <!-- Divider -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Available Units -->
                <TabControl 
                    Grid.Row="0"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    SelectedIndex="{Binding SelectedAvailableUnitTabIndex}"
                    BorderThickness="1"
                    Margin="{DynamicResource Space.S}">
                    <TabControl.Resources>
                        <!-- Style for TabItems -->
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border"
                                Margin="4,0,0,0"
                                Padding="12,8"
                                BorderThickness="1,1,1,0"
                                CornerRadius="0">
                                            <ContentPresenter ContentSource="Header"
                                            TextBlock.Foreground="{StaticResource Brush.Text.Dim}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.Border.Hairline}"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Brush.Border.Hairline}"/>
                                                <Setter Property="TextBlock.Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.Border.Hairline}"/>
                                                <Setter Property="TextBlock.Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                    </TabControl.Resources>

                    <!--
                        Each tab scrolls vertically. A WrapPanel needs a constrained width to wrap
                        at all and an unconstrained height to overflow into, which is exactly what
                        a vertical-only ScrollViewer gives it. Without these the rows past the
                        bottom of the tab were simply clipped and unreachable.
                    -->
                    <TabItem Header="Infantry">
                        <ScrollViewer Style="{StaticResource ScrollViewer.Thin}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AvailableInfantryUnits}"
                                ItemTemplate="{StaticResource AvailableUnitTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Support">
                        <ScrollViewer Style="{StaticResource ScrollViewer.Thin}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AvailableSupportUnits}"
                                ItemTemplate="{StaticResource AvailableUnitTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Armour">
                        <ScrollViewer Style="{StaticResource ScrollViewer.Thin}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AvailableArmourUnits}"
                                ItemTemplate="{StaticResource AvailableUnitTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Visibility="{Binding HasCapturedItems, Converter={StaticResource BooleanToVisibility}}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" ToolTip="Items captured by the company">
                                <Border
                                    Width="8"
                                    Height="8"
                                    Background="{StaticResource Brush.Status.Caution}"
                                    CornerRadius="0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    Text="Captured"
                                    Foreground="{StaticResource Brush.Status.Caution}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Style="{StaticResource ScrollViewer.Thin}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AvailableCapturedItems}"
                                ItemTemplate="{StaticResource CapturedItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Divider -->
                <Grid Grid.Row="1" Margin="8,0,8,8">

                    <TextBlock
                        Text="Company Units"
                        FontSize="{DynamicResource Font.Size.Body}"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.Text.Dim}"/>

                    <StackPanel 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Company Value:"
                            FontSize="{DynamicResource Font.Size.Eyebrow}"
                            FontStyle="Italic"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Brush.Text.Dim}"
                            Margin="8,0,8,0"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel 
                                Orientation="Horizontal"
                                Visibility="{Binding TotalManpowerCost, Converter={StaticResource ZeroToVisibilityConverter}}">
                                <Image 
                                    Width="{DynamicResource Size.Icon.M}"
                                    Height="{DynamicResource Size.Icon.M}"
                                    Source="pack://siteoforigin:,,,/Assets/Resources/coh3_manpower_small.png"/>
                                <TextBlock 
                                    Margin="4,0,0,0"
                                    Text="{Binding TotalManpowerCost}"
                                    Foreground="{StaticResource Brush.Text.Primary}"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel 
                                Orientation="Horizontal"
                                Margin="8,0,0,0"
                                Visibility="{Binding TotalMunitionsCost, Converter={StaticResource ZeroToVisibilityConverter}}">
                                <Image 
                                    Width="{DynamicResource Size.Icon.M}"
                                    Height="{DynamicResource Size.Icon.M}"
                                    Source="pack://siteoforigin:,,,/Assets/Resources/coh3_munitions_small.png"/>
                                <TextBlock 
                                    Margin="4,0,0,0"
                                    Text="{Binding TotalMunitionsCost}"
                                    Foreground="{StaticResource Brush.Text.Primary}"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel 
                                Orientation="Horizontal"
                                Margin="8,0,0,0"
                                Visibility="{Binding TotalFuelCost, Converter={StaticResource ZeroToVisibilityConverter}}">
                                <Image 
                                    Width="{DynamicResource Size.Icon.M}"
                                    Height="{DynamicResource Size.Icon.M}"
                                    Source="pack://siteoforigin:,,,/Assets/Resources/coh3_fuel_small.png"/>
                                <TextBlock 
                                    Margin="4,0,0,0"
                                    Text="{Binding TotalFuelCost}"
                                    Foreground="{StaticResource Brush.Text.Primary}"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    
                    
                </Grid>
                
                <!-- Company Composition -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Margin="8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock
                                FontSize="{DynamicResource Font.Size.Body}" 
                                Grid.Row="0"
                                FontWeight="Bold"
                                Foreground="{StaticResource Brush.Text.Dim}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center">
                                Starting Units (<Run Text="{Binding StartingUnitsCount, Mode=OneWay}"/>/<Run Text="{Binding StartingUnitsMax, Mode=OneWay}"/>)
                            </TextBlock>
                            <ScrollViewer Style="{StaticResource ScrollViewer.Thin}" Grid.Row="1">
                                <ItemsControl
                                    ItemsSource="{Binding StartingUnits}"
                                    ItemTemplate="{StaticResource CompanyUnitTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border
                        Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Margin="8,0"
                        Grid.Column="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock 
                                FontSize="{DynamicResource Font.Size.Body}" 
                                Grid.Row="0"
                                FontWeight="Bold"
                                Foreground="{StaticResource Brush.Text.Dim}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center">                                
                                Skirmish Units (<Run Text="{Binding SkirmishPhaseUnitsCount, Mode=OneWay}"/>/<Run Text="{Binding SkirmishPhaseUnitsMax, Mode=OneWay}"/>)
                            </TextBlock>
                            <ScrollViewer Style="{StaticResource ScrollViewer.Thin}" Grid.Row="1">
                                <ItemsControl
                                    ItemsSource="{Binding SkirmishPhaseUnits}"
                                    ItemTemplate="{StaticResource CompanyUnitTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border
                        Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Margin="8,0"
                        Grid.Column="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock 
                                FontSize="{DynamicResource Font.Size.Body}" 
                                Grid.Row="0"
                                FontWeight="Bold"
                                Foreground="{StaticResource Brush.Text.Dim}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center">                                
                                Battle Phase (<Run Text="{Binding BattlePhaseUnitsCount, Mode=OneWay}"/>/<Run Text="{Binding BattlePhaseUnitsMax, Mode=OneWay}"/>)
                            </TextBlock>
                            <ScrollViewer Style="{StaticResource ScrollViewer.Thin}" Grid.Row="1">
                                <ItemsControl
                                    ItemsSource="{Binding BattlePhaseUnits}"
                                    ItemTemplate="{StaticResource CompanyUnitTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border
                        Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Margin="8,0"
                        Grid.Column="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock 
                                FontSize="{DynamicResource Font.Size.Body}" 
                                Grid.Row="0"
                                FontWeight="Bold"
                                Foreground="{StaticResource Brush.Text.Dim}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center">                       
                                Reserves (<Run Text="{Binding ReservesPhaseUnitsCount, Mode=OneWay}"/>/<Run Text="{Binding ReservesPhaseUnitsMax, Mode=OneWay}"/>)
                            </TextBlock>
                            <ScrollViewer Style="{StaticResource ScrollViewer.Thin}" Grid.Row="1">
                                <ItemsControl
                                    ItemsSource="{Binding ReservesPhaseUnits}"
                                    ItemTemplate="{StaticResource CompanyUnitTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>

            </Grid>

            <!-- Selection/Hover infor -->
            <Border Grid.Column="1"
                  Margin="10,0,0,0"
                  Background="{StaticResource Brush.Surface.Card}"
                  BorderBrush="{StaticResource Brush.Border.Hairline}"
                  BorderThickness="1"
                  CornerRadius="0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selection -->
                    <TextBlock
                            Margin="{DynamicResource Space.S}"
                            Text="{Binding SelectionTitle}"
                            HorizontalAlignment="Center"
                            FontSize="{DynamicResource Font.Size.Group}"
                            FontWeight="Bold"
                            Foreground="{StaticResource Brush.Text.Primary}"/>

                    <!-- Selected unit information -->
                    <Grid 
                        Grid.Row="1"
                        Visibility="{Binding HasSquadSelection, Converter={StaticResource BooleanToVisibility}}">
                        <Grid DataContext="{Binding SquadSelectionViewModel}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Squad details -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource Brush.Surface.Sunken}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Margin="8,0,8,8"
                                    Padding="{DynamicResource Space.S}"
                                    Visibility="{Binding Converter={StaticResource NullVisibilityConverter}}">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                            
                                    <!-- Squad name -->
                                    <StackPanel 
                                        Orientation="Horizontal"
                                        Grid.Row="0">
                                        <!-- Squad icon -->
                                        <Image Width="{DynamicResource Size.Icon.Huge}" Height="{DynamicResource Size.Icon.Huge}">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                                    <Binding Path="Blueprint"/>
                                                    <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <StackPanel                                    
                                            VerticalAlignment="Center">
                                            <TextBlock 
                                                Text="{Binding Blueprint, Converter={StaticResource BlueprintNameConverter}}"
                                                FontSize="{DynamicResource Font.Size.Section}" 
                                                FontWeight="Bold"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                TextWrapping="Wrap"
                                                Margin="8,0,0,0"/>

                                            <TextBlock
                                                Text="{Binding CustomName}"
                                                FontSize="{DynamicResource Font.Size.Section}" 
                                                FontStyle="Italic"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                TextWrapping="Wrap"
                                                Margin="8,0,0,0"/>
                                    
                                        </StackPanel>
                                    </StackPanel>
                            
                                    <!-- Squad descriptions -->
                                    <StackPanel
                                        Margin="0,8,0,0"
                                        Grid.Row="1">

                                        <Grid x:Name="VeterancyDisplay" Margin="0,4,0,4" Visibility="{Binding IsSquad, Converter={StaticResource BooleanToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Rank Stars Display -->
                                            <StackPanel 
                                                Grid.Column="0"
                                                Grid.RowSpan="2"
                                                Orientation="Horizontal" 
                                                VerticalAlignment="Top"
                                                HorizontalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding RankStars}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Width="{DynamicResource Size.Icon.XS}" Height="{DynamicResource Size.Icon.XS}" Source="pack://siteoforigin:,,,/Assets/Misc/vstar.png">
                                                                <Image.Effect>
                                                                    <e:ColourTintBitmapEffect 
                                                                        TintColour="{Binding IsEarned, Converter={StaticResource RankStarColourConverter}}"/>
                                                                </Image.Effect>
                                                            </Image>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Rank Progress Bar -->
                                            <ProgressBar Grid.Column="1" 
                                                 Height="14" 
                                                 Margin="8,0,8,0"
                                                 Value="{Binding RankProgress}" 
                                                 Maximum="1"
                                                         VerticalAlignment="Center"
                                                 Background="{StaticResource Brush.Surface.Sunken}"
                                                 Foreground="{StaticResource Brush.Accent.Gold}"/>

                                            <!-- Experience Points Display -->
                                            <TextBlock 
                                                Grid.Column="1"
                                                Grid.Row="1"
                                                FontSize="{DynamicResource Font.Size.Label}"
                                                HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                Foreground="{StaticResource Brush.Text.Primary}">
                                                <Run Text="{Binding Experience, StringFormat={}{0}}"/>
                                                <Run Text="/"/>
                                                <Run Text="{Binding NextRankExperience, StringFormat={}{0}}"/>
                                                <Run Text="XP"/>
                                            </TextBlock>
                                        </Grid>

                                        <TextBlock 
                                            Text="{Binding Blueprint, Converter={StaticResource BlueprintHelpTextConverter}}"
                                            FontSize="{DynamicResource Font.Size.Body}" 
                                            Foreground="{StaticResource Brush.Text.Dim}"
                                            TextWrapping="Wrap"/>
                                        <TextBlock 
                                            Text="{Binding Blueprint, Converter={StaticResource BlueprintBriefTextConverter}}"
                                            FontSize="{DynamicResource Font.Size.Eyebrow}"
                                            FontStyle="Italic"
                                            Margin="0,8,0,0"
                                            Foreground="{StaticResource Brush.Text.Dim}"/>
                                    </StackPanel>

                                    <!-- Squad Costs -->
                                    <StackPanel 
                                        Orientation="Horizontal" 
                                        VerticalAlignment="Bottom" 
                                        Margin="0,18,0,0"
                                        Grid.Row="2">

                                        <StackPanel 
                                            Orientation="Horizontal"
                                            Visibility="{Binding Blueprint.Cost.Manpower, Converter={StaticResource ZeroToVisibilityConverter}}">
                                            <Image 
                                                Width="{DynamicResource Size.Icon.M}"
                                                Height="{DynamicResource Size.Icon.M}"
                                                Source="pack://siteoforigin:,,,/Assets/Resources/coh3_manpower_small.png"/>
                                            <TextBlock 
                                                Margin="4,0,0,0"
                                                Text="{Binding Blueprint.Cost.Manpower}"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                VerticalAlignment="Center"
                                                />
                                        </StackPanel>

                                        <StackPanel 
                                            Orientation="Horizontal"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding Blueprint.Cost.Munitions, Converter={StaticResource ZeroToVisibilityConverter}}">
                                            <Image 
                                                Width="{DynamicResource Size.Icon.M}"
                                                Height="{DynamicResource Size.Icon.M}"
                                                Source="pack://siteoforigin:,,,/Assets/Resources/coh3_munitions_small.png"/>
                                            <TextBlock 
                                                Margin="4,0,0,0"
                                                Text="{Binding Blueprint.Cost.Munitions}"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                VerticalAlignment="Center"
                                                />
                                        </StackPanel>
                                
                                        <StackPanel 
                                            Orientation="Horizontal"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding Blueprint.Cost.Fuel, Converter={StaticResource ZeroToVisibilityConverter}}">
                                            <Image 
                                                Width="{DynamicResource Size.Icon.M}"
                                                Height="{DynamicResource Size.Icon.M}"
                                                Source="pack://siteoforigin:,,,/Assets/Resources/coh3_fuel_small.png"/>
                                            <TextBlock 
                                                Margin="4,0,0,0"
                                                Text="{Binding Blueprint.Cost.Fuel}"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                VerticalAlignment="Center"
                                                />
                                        </StackPanel>

                                    </StackPanel>

                                </Grid>
                            </Border>
                    
                            <!-- Squad Purchase options -->
                            <Grid
                                Visibility="{Binding Converter={StaticResource NullVisibilityConverter}}"                       
                                Grid.Row="1">

                                <Border
                                    Visibility="{Binding IsSquad, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                    Background="{StaticResource Brush.Surface.Sunken}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Margin="8,0,8,8"
                                    Padding="{DynamicResource Space.S}">

                                    <StackPanel>
                                        <TextBlock
                                            Margin="{DynamicResource Space.XS}"
                                            Text="Add to Company"
                                            HorizontalAlignment="Center"
                                            FontSize="{DynamicResource Font.Size.Section}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Brush.Text.Dim}"/>
                                        <Button 
                                            Content="Add to Starting Units" 
                                            Grid.Column="0" 
                                            Grid.Row="0" 
                                            Style="{StaticResource Button.Primary}" 
                                            IsEnabled="{Binding DataContext.CanAddStartingUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="{DynamicResource Space.XS}"
                                            Command="{Binding AddToCompanyCommand}">
                                            <Button.CommandParameter>
                                                <c:SquadPhase>StartingPhase</c:SquadPhase>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button 
                                            Content="Add to Skirmish Phase" 
                                            Grid.Column="1" 
                                            Grid.Row="0" 
                                            Style="{StaticResource Button.Primary}" 
                                            IsEnabled="{Binding DataContext.CanAddSkirmishPhaseUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="{DynamicResource Space.XS}"
                                            Command="{Binding AddToCompanyCommand}">
                                            <Button.CommandParameter>
                                                <c:SquadPhase>SkirmishPhase</c:SquadPhase>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button 
                                            Content="Add to Battle Phase" 
                                            Grid.Column="0" 
                                            Grid.Row="1" 
                                            Style="{StaticResource Button.Primary}" 
                                            IsEnabled="{Binding DataContext.CanAddBattlePhaseUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="{DynamicResource Space.XS}"
                                            Command="{Binding AddToCompanyCommand}">
                                            <Button.CommandParameter>
                                                <c:SquadPhase>BattlePhase</c:SquadPhase>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button 
                                            Content="Add to Reserves" 
                                            Grid.Column="1" 
                                            Grid.Row="1" 
                                            Style="{StaticResource Button.Primary}" 
                                            IsEnabled="{Binding DataContext.CanAddReservesPhaseUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="{DynamicResource Space.XS}"
                                            Command="{Binding AddToCompanyCommand}">
                                            <Button.CommandParameter>
                                                <c:SquadPhase>ReservesPhase</c:SquadPhase>
                                            </Button.CommandParameter>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                    
                            <!-- Squad Configuration -->
                            <StackPanel
                                Visibility="{Binding Converter={StaticResource NullVisibilityConverter}}"                       
                                Grid.Row="2">

                                <!-- Squad upgrades -->
                                <Border
                                    Visibility="{Binding HasUpgrades, Converter={StaticResource BooleanToVisibility}}"
                                    Background="{StaticResource Brush.Surface.Sunken}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Margin="8,0,8,8"
                                    Padding="{DynamicResource Space.S}">
                                    <StackPanel>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="{DynamicResource Space.XS}"
                                            Text="Squad Upgrades"
                                            HorizontalAlignment="Center"
                                            FontSize="{DynamicResource Font.Size.Section}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Brush.Text.Dim}"/>
                                        <ItemsControl
                                            Grid.Row="1"
                                            ItemTemplate="{StaticResource SquadUpgradeTemplate}"
                                            ItemsSource="{Binding Upgrades}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Squad Items -->
                                <Border
                                    Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibility}}"
                                    Background="{StaticResource Brush.Surface.Sunken}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Margin="8,0,8,8"
                                    Padding="{DynamicResource Space.S}">
                                    <StackPanel>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="{DynamicResource Space.XS}"
                                            Text="Squad Items"
                                            HorizontalAlignment="Center"
                                            FontSize="{DynamicResource Font.Size.Section}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Brush.Text.Dim}"/>
                                        <ItemsControl
                                            Grid.Row="1"
                                            ItemTemplate="{StaticResource SquadItemTemplate}"
                                            ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Squad Deployment -->
                                <Border
                                    Visibility="{Binding IsTransportable, Converter={StaticResource BooleanToVisibility}}"
                                    Background="{StaticResource Brush.Surface.Sunken}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Margin="8,0,8,8"
                                    Padding="{DynamicResource Space.S}">
                                    <StackPanel>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="{DynamicResource Space.XS}"
                                            Text="Squad Deployment"
                                            HorizontalAlignment="Center"
                                            FontSize="{DynamicResource Font.Size.Section}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Brush.Text.Dim}"/>

                                        <RadioButton 
                                            Style="{StaticResource TransportRadioButton}"
                                            GroupName="TransportSelection"
                                            x:Name="NoTransportOption"
                                            Content="No Transport"
                                            IsChecked="{Binding HasTransport, Converter={StaticResource InverseBooleanConverter}}"
                                            Margin="{DynamicResource Space.XS}"
                                            IsEnabled="{Binding CanDisableTransport}"
                                            Foreground="{StaticResource Brush.Text.Primary}"
                                            VerticalContentAlignment="Center"/>

                                        <RadioButton 
                                            Style="{StaticResource TransportRadioButton}"
                                            x:Name="DropOffRadio"
                                            GroupName="TransportSelection"
                                            Content="Transport (Drop-Off)"
                                            IsChecked="{Binding HasDropOffTransport}"
                                            Margin="{DynamicResource Space.XS}"
                                            Foreground="{StaticResource Brush.Text.Primary}"
                                            VerticalContentAlignment="Center"/>

                                        <ComboBox
                                            Margin="{DynamicResource Space.XS}"
                                            Style="{StaticResource ComboBox.Default}"
                                            ItemTemplate="{StaticResource TransportItemTemplate}"
                                            ItemsSource="{Binding AvailableTransports}"
                                            SelectedItem="{Binding TransportBlueprint}"
                                            Visibility="{Binding HasTransport, Converter={StaticResource BooleanToVisibility}}"
                                            IsEnabled="{Binding ElementName=NoTransportOption, Path=IsChecked, Converter={StaticResource InverseBooleanConverter}}"/>

                                    </StackPanel>
                                </Border>

                                <!-- Squad Passengers -->
                                <Border
                                    Visibility="{Binding CanHavePassengers, Converter={StaticResource BooleanToVisibility}}"
                                    Background="{StaticResource Brush.Surface.Sunken}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Margin="8,0,8,8"
                                    Padding="{DynamicResource Space.S}">

                                    <StackPanel>
                                        <TextBlock
                                            Margin="{DynamicResource Space.XS}"
                                            Text="Passenger Unit"
                                            HorizontalAlignment="Center"
                                            FontSize="{DynamicResource Font.Size.Section}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Brush.Text.Dim}"/>

                                        <!-- Infantry unit picker -->
                                        <ComboBox
                                            Margin="{DynamicResource Space.XS}"
                                            Style="{StaticResource ComboBox.Default}"
                                            ItemsSource="{Binding AvailablePassengers}"
                                            SelectedItem="{Binding SelectedPassenger, Mode=TwoWay}"
                                            Visibility="{Binding HasAvailablePassengers, Converter={StaticResource BooleanToVisibility}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0"
                                                               Width="{DynamicResource Size.Icon.M}"
                                                               Height="{DynamicResource Size.Icon.M}"
                                                               Margin="0,0,8,0">
                                                            <Image.Source>
                                                                <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                                                    <Binding Path="Blueprint"/>
                                                                    <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </Image.Source>
                                                        </Image>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource Brush.Text.Primary}">
                                                            <Run Text="{Binding Blueprint, Converter={StaticResource BlueprintNameConverter}, Mode=OneWay}"/> (#<Run Text="{Binding Id, Mode=OneWay}"/>)
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock
                                            Margin="{DynamicResource Space.XS}"
                                            Text="No infantry units available in this phase."
                                            FontStyle="Italic"
                                            HorizontalAlignment="Center"
                                            Foreground="{StaticResource Brush.Text.Dim}"
                                            Visibility="{Binding HasAvailablePassengers, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>

                                        <Button
                                            Margin="{DynamicResource Space.XS}"
                                            Content="Clear Passenger"
                                            Style="{StaticResource Button.Danger}"
                                            Command="{Binding ClearPassengerCommand}"
                                            Visibility="{Binding HasPassenger, Converter={StaticResource BooleanToVisibility}}"/>
                                    </StackPanel>

                                </Border>

                            </StackPanel>
                    
                            <!-- Retire Squad Button -->
                            <Grid
                                Grid.Row="4"
                                Visibility="{Binding Converter={StaticResource NullVisibilityConverter}}">

                                <Button
                                    Visibility="{Binding IsSquad, Converter={StaticResource BooleanToVisibility}}"
                                    VerticalAlignment="Bottom"
                                    Margin="{DynamicResource Space.S}"
                                    Content="Retire Squad"
                                    Command="{Binding RetireSquadCommand}"
                                    Style="{StaticResource Button.Danger}"
                                    />
                            </Grid>
                    
                        </Grid>
                    </Grid>
                    
                    <!-- Selected item information -->
                    <Grid
                        Grid.Row="1"
                        Visibility="{Binding HasItemSelection, Converter={StaticResource BooleanToVisibility}}">
                        <Grid DataContext="{Binding ItemSelectionViewModel}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Item details -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource Brush.Surface.Sunken}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Margin="8,0,8,8"
                                    Padding="{DynamicResource Space.S}"
                                    Visibility="{Binding Converter={StaticResource NullVisibilityConverter}}">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Item icon -->
                                    <Image Width="{DynamicResource Size.Icon.Huge}" Height="{DynamicResource Size.Icon.Huge}">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                                <Binding Path="Blueprint"/>
                                                <Binding Path="DataContext.Game" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>

                                    <!-- Item descriptions (if any) -->
                                    <StackPanel
                                        Margin="0,8,0,0"
                                        Grid.Row="1">

                                        <TextBlock 
                                            Text="{Binding Blueprint, Converter={StaticResource BlueprintNameConverter}}"
                                            FontSize="{DynamicResource Font.Size.Section}" 
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Brush.Text.Primary}"
                                            TextWrapping="Wrap"
                                            HorizontalAlignment="Center"
                                            Margin="8,0,0,0"/>
                                        <TextBlock 
                                            Text="{Binding Blueprint, Converter={StaticResource BlueprintHelpTextConverter}, ConverterParameter='EmptyStringIfNotFound'}"
                                            FontSize="{DynamicResource Font.Size.Body}" 
                                            Foreground="{StaticResource Brush.Text.Dim}"
                                            TextWrapping="Wrap"/>
                                        <TextBlock 
                                            Text="{Binding Blueprint, Converter={StaticResource BlueprintBriefTextConverter}, ConverterParameter='EmptyStringIfNotFound'}"
                                            FontSize="{DynamicResource Font.Size.Eyebrow}"
                                            FontStyle="Italic"
                                            Margin="0,8,0,0"
                                            Foreground="{StaticResource Brush.Text.Dim}"/>
                                    </StackPanel>

                                    <!-- Item Costs -->
                                    <StackPanel 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom" 
                                        Visibility="{Binding HasCostInfo, Converter={StaticResource BooleanToVisibility}}"
                                        Margin="0,18,0,0"
                                        Grid.Row="2">

                                        <StackPanel 
                                            Orientation="Horizontal"
                                            Visibility="{Binding Cost.Manpower, Converter={StaticResource ZeroToVisibilityConverter}}">
                                            <Image 
                                                Width="{DynamicResource Size.Icon.M}"
                                                Height="{DynamicResource Size.Icon.M}"
                                                Source="pack://siteoforigin:,,,/Assets/Resources/coh3_manpower_small.png"/>
                                            <TextBlock 
                                                Margin="4,0,0,0"
                                                Text="{Binding Cost.Manpower}"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                VerticalAlignment="Center"
                                                />
                                        </StackPanel>

                                        <StackPanel 
                                            Orientation="Horizontal"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding Cost.Munitions, Converter={StaticResource ZeroToVisibilityConverter}}">
                                            <Image 
                                                Width="{DynamicResource Size.Icon.M}"
                                                Height="{DynamicResource Size.Icon.M}"
                                                Source="pack://siteoforigin:,,,/Assets/Resources/coh3_munitions_small.png"/>
                                            <TextBlock 
                                                Margin="4,0,0,0"
                                                Text="{Binding Cost.Munitions}"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                VerticalAlignment="Center"
                                                />
                                        </StackPanel>

                                        <StackPanel 
                                            Orientation="Horizontal"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding Cost.Fuel, Converter={StaticResource ZeroToVisibilityConverter}}">
                                            <Image 
                                                Width="{DynamicResource Size.Icon.M}"
                                                Height="{DynamicResource Size.Icon.M}"
                                                Source="pack://siteoforigin:,,,/Assets/Resources/coh3_fuel_small.png"/>
                                            <TextBlock 
                                                Margin="4,0,0,0"
                                                Text="{Binding Cost.Fuel}"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                VerticalAlignment="Center"
                                                />
                                        </StackPanel>

                                    </StackPanel>

                                </Grid>
                            </Border>
                            
                            <!-- Deploy to phase if team weapon -->
                            <Grid
                                Visibility="{Binding Converter={StaticResource NullVisibilityConverter}}"                       
                                Grid.Row="1">

                                <Border
                                    Visibility="{Binding IsTeamWeapon, Converter={StaticResource BooleanToVisibility}}"
                                    Background="{StaticResource Brush.Surface.Sunken}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Margin="8,0,8,8"
                                    Padding="{DynamicResource Space.S}">

                                    <StackPanel>
                                        <TextBlock
                                            Margin="{DynamicResource Space.XS}"
                                            Text="Add to Company"
                                            HorizontalAlignment="Center"
                                            FontSize="{DynamicResource Font.Size.Section}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Brush.Text.Dim}"/>
                                        <Button 
                                            Content="Add to Starting Units" 
                                            Grid.Column="0" 
                                            Grid.Row="0" 
                                            Style="{StaticResource Button.Primary}" 
                                            IsEnabled="{Binding DataContext.CanAddStartingUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="{DynamicResource Space.XS}"
                                            Command="{Binding AddToCompanyCommand}">
                                            <Button.CommandParameter>
                                                <c:SquadPhase>StartingPhase</c:SquadPhase>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button 
                                            Content="Add to Skirmish Phase" 
                                            Grid.Column="1" 
                                            Grid.Row="0" 
                                            Style="{StaticResource Button.Primary}" 
                                            IsEnabled="{Binding DataContext.CanAddSkirmishPhaseUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="{DynamicResource Space.XS}"
                                            Command="{Binding AddToCompanyCommand}">
                                            <Button.CommandParameter>
                                                <c:SquadPhase>SkirmishPhase</c:SquadPhase>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button 
                                            Content="Add to Battle Phase" 
                                            Grid.Column="0" 
                                            Grid.Row="1" 
                                            Style="{StaticResource Button.Primary}" 
                                            IsEnabled="{Binding DataContext.CanAddBattlePhaseUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="{DynamicResource Space.XS}"
                                            Command="{Binding AddToCompanyCommand}">
                                            <Button.CommandParameter>
                                                <c:SquadPhase>BattlePhase</c:SquadPhase>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button 
                                            Content="Add to Reserves" 
                                            Grid.Column="1" 
                                            Grid.Row="1" 
                                            Style="{StaticResource Button.Primary}" 
                                            IsEnabled="{Binding DataContext.CanAddReservesPhaseUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="{DynamicResource Space.XS}"
                                            Command="{Binding AddToCompanyCommand}">
                                            <Button.CommandParameter>
                                                <c:SquadPhase>ReservesPhase</c:SquadPhase>
                                            </Button.CommandParameter>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <!-- Add to unit if slot item -->
                            <Grid
                                Grid.Row="1"
                                Visibility="{Binding Converter={StaticResource NullVisibilityConverter}}">
                                <Border
                                    Visibility="{Binding IsTeamWeapon, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                    Background="{StaticResource Brush.Surface.Sunken}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Margin="8,0,8,8"
                                    Padding="{DynamicResource Space.S}">

                                    <StackPanel>
                                        <TextBlock
                                            Margin="{DynamicResource Space.XS}"
                                            Text="Add to unit"
                                            HorizontalAlignment="Center"
                                            FontSize="{DynamicResource Font.Size.Section}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Brush.Text.Dim}"/>

                                        <ScrollViewer 
                                            MaxHeight="348"
                                            Style="{StaticResource ScrollViewer.Thin}">
                                            <ItemsControl 
                                                ItemsSource="{Binding ItemAssignableUnits}"
                                                ItemTemplate="{StaticResource SquadItemAssignmentTemplate}"/>
                                        </ScrollViewer>
                                        
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <!-- Destroy Item button -->
                            <Button
                                    Grid.Row="4"
                                    VerticalAlignment="Bottom"
                                    Margin="{DynamicResource Space.S}"
                                    Style="{StaticResource Button.Danger}"
                                    Command="{Binding DestroyItemCommand}"
                                    Content="Destroy Item"/>

                        </Grid>
                    </Grid>
                    
                </Grid>

            </Border>
            
        </Grid>

        <!-- Footer with Save Button -->
        <Grid Grid.Row="2" Margin="0,8,0,0">

            <StackPanel 
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Label 
                    Content="{Binding CompanyState}"
                    Foreground="{StaticResource Brush.Text.Primary}"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <Button 
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Right"
                Style="{StaticResource Button.Primary}"
                IsEnabled="{Binding CanSave}">
                Save Company
            </Button>
        </Grid>

    </Grid>
</UserControl>
