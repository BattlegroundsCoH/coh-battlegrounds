<helpers:DialogUserControl x:Class="Battlegrounds.Views.Modals.CreateLobbyModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Battlegrounds.Views.Modals"
                           xmlns:helpers="clr-namespace:Battlegrounds.Helpers"
                           xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels.Modals"
             mc:Ignorable="d" 
                           d:DataContext="{d:DesignInstance Type=viewmodels:CreateLobbyModalViewModel}"
                           MinWidth="420" MaxWidth="600"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="{StaticResource Brush.Surface.Card}"
        BorderBrush="{StaticResource Brush.Border.Hairline}"
        BorderThickness="1"
        CornerRadius="0">
        <Grid Margin="{DynamicResource Space.XL}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="CREATE NEW LOBBY"
                   FontSize="{DynamicResource Font.Size.Heading}"
                   FontWeight="Bold"
                   Foreground="{StaticResource Brush.Text.Primary}"
                   Margin="0,0,0,20"/>

            <!-- Form Content -->
            <StackPanel Grid.Row="1">
                <StackPanel>
                    <TextBlock Text="Lobby Name"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           Margin="0,0,0,5"/>
                    <TextBox 
                        Style="{StaticResource TextBox.Field}"
                        Text="{Binding LobbyName, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="32"/>
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Password (Optional)"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource PasswordBox.Field}"
                            PasswordChanged="PasswordBox_PasswordChanged"/>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
                <Button Content="Cancel"
                    Width="100"
                        Style="{StaticResource Button.Danger}"
                    Command="{Binding CancelCommand}"/>
                <Button Content="Create"
                    Width="100"
                        Style="{StaticResource Button.Primary}"
                        Margin="8,0,0,0"
                    Command="{Binding CreateCommand}"
                    IsEnabled="{Binding CanCreate}"/>
            </StackPanel>
        </Grid>
    </Border>
</helpers:DialogUserControl>
