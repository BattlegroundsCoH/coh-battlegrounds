<helpers:DialogUserControl x:Class="Battlegrounds.Views.Modals.CreateCompanyModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Battlegrounds.Views.Modals"
             xmlns:helpers="clr-namespace:Battlegrounds.Helpers"
             xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels.Modals"
             xmlns:converters="clr-namespace:Battlegrounds.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CreateCompanyModalViewModel}"
             MinWidth="640" MaxWidth="900"
             d:DesignHeight="550" d:DesignWidth="800">
    <helpers:DialogUserControl.Resources>
        <converters:FactionIconMultiBindingConverter x:Key="FactionIconConverter"/>
        <converters:FactionIdToNameConverter x:Key="FactionIdToNameConverter"/>
        <converters:NullVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BlueprintIconMultiBindingConverter x:Key="BlueprintIconMultiConverter"/>
        <converters:BlueprintNameConverter x:Key="BlueprintNameConverter"/>
        <converters:BlueprintBriefTextConverter x:Key="BlueprintBriefTextConverter"/>
        <converters:BlueprintHelpTextConverter x:Key="BlueprintHelpTextConverter"/>
        
        <DataTemplate x:Key="FactionComboBoxItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Faction icon -->
                <Image Width="{DynamicResource Size.Icon.S}" Height="{DynamicResource Size.Icon.S}" Margin="0,0,8,0">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource FactionIconConverter}">
                            <Binding Path="."/>
                            <Binding Path="DataContext.SelectedGame" RelativeSource="{RelativeSource AncestorType=helpers:DialogUserControl}"/>
                        </MultiBinding>
                    </Image.Source>
                </Image>
                <!-- Faction name -->
                <TextBlock Grid.Column="1"
                    VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource FactionIdToNameConverter}">
                            <Binding Path="."/>
                            <Binding Path="DataContext.SelectedGame" RelativeSource="{RelativeSource AncestorType=helpers:DialogUserControl}"/>                            
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <Style x:Key="DoctrineCardListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DoctrineCardItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{StaticResource Brush.Border.Hairline}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,4,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                BorderThickness="2"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource Brush.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource Brush.Surface.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DoctrineCardDataTemplate">
            <StackPanel>
                <Image 
                    Width="{DynamicResource Size.Icon.XL}" Height="{DynamicResource Size.Icon.XL}"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Source="{Binding Icon}"
                    RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock 
                    Text="{Binding Name}"
                    FontWeight="SemiBold"
                    FontSize="{DynamicResource Font.Size.Meta}"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{StaticResource Brush.Text.Primary}"/>
                <StackPanel.ToolTip>
                    <ToolTip Style="{StaticResource ToolTip.Default}">
                        <StackPanel>
                            <TextBlock 
                                Text="{Binding Name}"
                                FontWeight="SemiBold"
                                FontSize="{DynamicResource Font.Size.Meta}"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Left"
                                TextAlignment="Center"
                                Foreground="{StaticResource Brush.Text.Primary}"/>
                            <TextBlock
                                Text="{Binding Description}"
                                FontSize="{DynamicResource Font.Size.Meta}"
                                TextWrapping="Wrap"
                                MaxWidth="320"
                                Foreground="{StaticResource Brush.Text.Body}"/>
                        </StackPanel>
                    </ToolTip>
                </StackPanel.ToolTip>
            </StackPanel>
        </DataTemplate>

    </helpers:DialogUserControl.Resources>
    <Border 
        Background="{StaticResource Brush.Surface.Card}"
        BorderBrush="{StaticResource Brush.Border.Hairline}"
        BorderThickness="1"
        CornerRadius="0">
        <Grid Margin="{DynamicResource Space.L}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="CREATE NEW COMPANY"
               FontSize="{DynamicResource Font.Size.Heading}"
               FontWeight="Bold"
               Foreground="{StaticResource Brush.Text.Primary}"
               Margin="0,0,0,20"/>

            <!-- Form Content -->
            <StackPanel Grid.Row="1">
                <StackPanel>
                    <TextBlock Text="Company Name"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       Margin="0,0,0,5"/>
                    <TextBox 
                        Style="{StaticResource TextBox.Field}"
                        Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="32"/>
                </StackPanel>

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Game"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableGames}"
                              SelectedItem="{Binding SelectedGame}"
                              DisplayMemberPath="GameName"
                              Style="{StaticResource ComboBox.Default}"/>
                </StackPanel>

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Faction"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableFactions}"
                              SelectedItem="{Binding SelectedFaction}"
                              Style="{StaticResource ComboBox.Default}"
                              ItemTemplate="{StaticResource FactionComboBoxItemTemplate}"/>
                </StackPanel>

                <StackPanel Margin="0,8,0,12">
                    <TextBlock Text="Doctrine"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       Margin="0,0,0,5"/>
                    <ListBox
                        HorizontalAlignment="Center"
                        ItemsSource="{Binding AvailableDoctrines}"
                        SelectedItem="{Binding SelectedDoctrine}"
                        Style="{StaticResource DoctrineCardListBox}"
                        ItemContainerStyle="{StaticResource DoctrineCardItem}"
                        ItemTemplate="{StaticResource DoctrineCardDataTemplate}"
                        Margin="0,0,0,8"/>
                    <!-- Selected doctrine detail panel -->
                    <Border
                        Background="{StaticResource Brush.Border.Hairline}"
                        BorderBrush="{StaticResource Brush.Accent.Gold}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Height="200"
                        Padding="12,10"
                        Visibility="{Binding SelectedDoctrine, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Text="{Binding SelectedDoctrine.Name}"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                FontSize="{DynamicResource Font.Size.BodySmall}"
                                Foreground="{StaticResource Brush.Text.Primary}"
                                Margin="0,0,0,4"/>
                            <TextBlock
                                Text="{Binding SelectedDoctrine.ShortDescription}"
                                FontSize="{DynamicResource Font.Size.Meta}"
                                TextWrapping="Wrap"
                                Height="50"
                                Foreground="{StaticResource Brush.Text.Body}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock 
                                    Text="Additional Units" 
                                    Grid.Row="0" 
                                    Foreground="{StaticResource Brush.Text.Primary}" 
                                    FontSize="{DynamicResource Font.Size.Eyebrow}" 
                                    HorizontalAlignment="Center"
                                    FontWeight="DemiBold"/>
                                <ItemsControl 
                                        Grid.Row="1"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        ItemsSource="{Binding SelectedDoctrine.ExclusiveSquadBlueprints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image 
                                                        Grid.Column="0"
                                                        Width="{DynamicResource Size.Icon.XL}"
                                                        Height="{DynamicResource Size.Icon.XL}"
                                                        Margin="0,0,12,0">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource BlueprintIconMultiConverter}">
                                                            <Binding Path="."/>
                                                            <Binding Path="DataContext.SelectedGame" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                    <Image.ToolTip>
                                                        <ToolTip Style="{StaticResource ToolTip.Default}" MaxWidth="360">
                                                            <StackPanel>
                                                                <TextBlock 
                                                                    Text="{Binding Converter={StaticResource BlueprintNameConverter}}"
                                                                    FontSize="{DynamicResource Font.Size.Section}" 
                                                                    FontWeight="Bold"
                                                                    Foreground="{StaticResource Brush.Text.Primary}"
                                                                    TextWrapping="Wrap"/>
                                                                <TextBlock 
                                                                    Text="{Binding Converter={StaticResource BlueprintHelpTextConverter}}"
                                                                    FontSize="{DynamicResource Font.Size.Body}" 
                                                                    Foreground="{StaticResource Brush.Text.Dim}"
                                                                    TextWrapping="Wrap"/>
                                                                <TextBlock 
                                                                    Text="{Binding Converter={StaticResource BlueprintBriefTextConverter}}"
                                                                    FontSize="{DynamicResource Font.Size.Eyebrow}"
                                                                    FontStyle="Italic"
                                                                    Margin="0,8,0,0"
                                                                    Foreground="{StaticResource Brush.Text.Dim}"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Image.ToolTip>
                                                </Image>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>

            <!-- Buttons -->
            <StackPanel 
                Grid.Row="2" 
                Orientation="Horizontal" 
                HorizontalAlignment="Right">
                <Button 
                    Content="Cancel"
                    Style="{StaticResource Button.Danger}"
                    Width="100"
                    Command="{Binding CancelCommand}"/>
                <Button 
                    Content="Create"
                    Style="{StaticResource Button.Primary}"
                    Margin="8,0,0,0"
                    Width="100"
                    Command="{Binding CreateCommand}"
                    IsEnabled="{Binding CanCreate}"/>
            </StackPanel>
        </Grid>
    </Border>
</helpers:DialogUserControl>
