<UserControl x:Class="Battlegrounds.Views.CompanyBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Battlegrounds.Views"
             xmlns:vm="clr-namespace:Battlegrounds.ViewModels"
             xmlns:vmh="clr-namespace:Battlegrounds.ViewModels.CompanyHelpers"
             xmlns:converters="clr-namespace:Battlegrounds.Converters"
             xmlns:controls="clr-namespace:Battlegrounds.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:CompanyBrowserViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:GameIdToGameNameConverter x:Key="GameIdToGameNameConverter"/>
        <converters:FactionIconMultiBindingConverter x:Key="FactionIconMultiBindingConverter"/>
        <converters:FactionIdToNameConverter x:Key="FactionIdToNameConverter"/>
        <converters:UpperCaseConverter x:Key="UpperCase"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Header="COMPANIES">
            <StackPanel Orientation="Horizontal">
                <Button Content="REFRESH"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding LoadCompaniesCommand}"
                        Margin="0,0,10,0"/>
                <Button Content="NEW COMPANY"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding CreateCompanyCommand}"/>
            </StackPanel>
        </controls:PageHeader>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface.Raised}"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="1"
                Padding="16">
            <Grid>
                <TreeView x:Name="CompanySelectionTreeView"
                          MouseDoubleClick="CompanySelectionTreeView_MouseDoubleClick"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource Brush.Text.Primary}"
                          ItemsSource="{Binding GameGroups}">
                    <TreeView.Resources>
                        <!--
                            Only the game groups are expandable; a company row is a leaf.
                            The template therefore renders its own chevron and indents
                            children by hand rather than using the stock expander chrome.
                        -->
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Padding" Value="0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border x:Name="HeaderBorder"
                                                    Grid.Row="0"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent"
                                                    BorderThickness="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ToggleButton x:Name="Expander"
                                                                  Grid.Column="0"
                                                                  Width="16" Height="16"
                                                                  Cursor="Hand"
                                                                  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Visibility="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent">
                                                                    <Path x:Name="ExpanderPath"
                                                                          Stroke="{StaticResource Brush.Text.Dim}"
                                                                          StrokeThickness="1.5"
                                                                          Data="M 1,5 L 5,9 L 9,5"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="ExpanderPath" Property="Data" Value="M 1,9 L 5,5 L 9,9"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ExpanderPath" Property="Stroke" Value="{StaticResource Brush.Accent.Gold}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>

                                                    <ContentPresenter Grid.Column="1"
                                                                      ContentSource="Header"
                                                                      Margin="6,0,0,0"/>
                                                </Grid>
                                            </Border>

                                            <ItemsPresenter x:Name="ItemsPresenter"
                                                            Grid.Row="1"
                                                            Margin="22,4,0,14"
                                                            Visibility="Collapsed"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="ItemsPresenter" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Resources>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vmh:GameGroup}"
                                                  ItemsSource="{Binding Companies}">
                            <StackPanel Orientation="Horizontal">
                                <controls:TrackedTextBlock Style="{StaticResource Display.Group}"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding GameType, Converter={StaticResource GameIdToGameNameConverter}}"/>
                                <TextBlock Style="{StaticResource Text.Meta}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Text="{Binding CompanyCount}"/>
                            </StackPanel>

                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.Surface.Window}"
                                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                                            BorderThickness="1"
                                            Padding="12,9"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="28" Height="28"
                                                    Margin="0,0,12,0"
                                                    Background="{StaticResource Brush.Faction.Axis}"
                                                    BorderBrush="{StaticResource Brush.Border.Default}"
                                                    BorderThickness="1">
                                                <Image Width="18" Height="18">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource FactionIconMultiBindingConverter}">
                                                            <Binding Path="Faction"/>
                                                            <Binding Path="GameId"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       Style="{StaticResource Text.Body}"
                                                       Foreground="{StaticResource Brush.Text.Primary}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="2"
                                                    Style="{StaticResource Button.Primary}"
                                                    Content="EDIT"
                                                    FontSize="11"
                                                    Padding="14,5"
                                                    Margin="8,0,8,0"
                                                    Command="{Binding DataContext.EditCompanyCommand,
                                                              RelativeSource={RelativeSource FindAncestor,
                                                              AncestorType={x:Type TreeView}}}"
                                                    CommandParameter="{Binding}"/>

                                            <Button Grid.Column="3"
                                                    Style="{StaticResource Button.Danger}"
                                                    Content="DELETE"
                                                    FontSize="11"
                                                    Padding="14,5"
                                                    Command="{Binding DataContext.DeleteCompanyCommand,
                                                              RelativeSource={RelativeSource FindAncestor,
                                                              AncestorType={x:Type TreeView}}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Busy overlay -->
                <Grid Background="{StaticResource Brush.Surface.Scrim}"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <controls:TrackedTextBlock Style="{StaticResource Display.Label}"
                                                   Text="LOADING"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,14"/>
                        <ProgressBar Style="{StaticResource ProgressBar.Default}"
                                     Width="200"
                                     IsIndeterminate="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface.Chrome}"
                Padding="16,10"
                Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Text.Meta}"
                       FontSize="12"
                       Text="{Binding StatusMessage}"/>
        </Border>
    </Grid>
</UserControl>
