<UserControl x:Class="Battlegrounds.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
             xmlns:converters="clr-namespace:Battlegrounds.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>


        <converters:FactionIdToNameConverter x:Key="FactionIdToNameConverter"/>
        <converters:FactionIconMultiBindingConverter x:Key="FactionIconConverter"/>
        <converters:RelativeTimeConverter x:Key="RelativeTimeConverter"/>
        <converters:DurationConverter x:Key="DurationConverter"/>

        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundBlueBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundWhiteBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardContent" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundWhiteBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundWhiteBrush}"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundWhiteBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Style="{StaticResource ChatScrollViewer}">
        <StackPanel>
            
            <!-- Hero Section -->
            <Border Style="{StaticResource DashboardCard}" Padding="20" Margin="10,0,10,15">
                <StackPanel>
                    <TextBlock Text="{Binding WelcomeMessage}"
                               Foreground="{StaticResource ForegroundWhiteBrush}"
                               FontSize="32" 
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>
                    
                    <!-- Player Stats Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Total Matches -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding TotalMatches}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="Total Matches" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                        
                        <!-- Victories -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding TotalVictories}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="Victories" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                        
                        <!-- Win Rate -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource StatValue}">
                                <Run Text="{Binding WinRate, Mode=OneWay}"/><Run Text="%"/>
                            </TextBlock>
                            <TextBlock Text="Win Rate" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                        
                        <!-- Rank -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{Binding Rank}" Style="{StaticResource StatValue}" FontSize="24"/>
                            <TextBlock Text="Current Rank" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Play Now Button -->
                    <Button Content="PLAY NOW" 
                            Command="{Binding DataContext.SingleplayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="#FF4CAF50"
                            Foreground="White"
                            FontSize="24"
                            FontWeight="Bold"
                            Height="70"
                            Margin="0,30,0,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF4CAF50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF66BB6A"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FF388E3C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Dashboard Cards Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Recent Matches Card -->
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource DashboardCard}" Height="300">
                    <StackPanel>
                        <TextBlock Text="Recent Matches" Style="{StaticResource CardTitle}"/>
                        <ItemsControl x:Name="RecentMatchesControl" ItemsSource="{Binding RecentMatches}" Margin="0,0,0,5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundLightBlueBrush}" 
                                            CornerRadius="6" 
                                            Padding="10" 
                                            Margin="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Faction Icon -->
                                            <Image Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource FactionIconConverter}">
                                                        <Binding Path="CompanyFaction"/>
                                                        <Binding Path="GameId"/>
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>

                                            <!-- Match Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource CardContent}" FontWeight="Bold">
                                                    <Run Text="{Binding CompanyName, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CardContent}" FontSize="11" Opacity="0.7">
                                                    <Run>
                                                        <Run.Text>
                                                            <MultiBinding Converter="{StaticResource FactionIdToNameConverter}">
                                                                <Binding Path="CompanyFaction"/>
                                                                <Binding Path="GameId"/>
                                                            </MultiBinding>
                                                        </Run.Text>
                                                    </Run>
                                                    <Run Text=" • "/>
                                                    <Run Text="{Binding Map, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CardContent}" FontSize="10" Opacity="0.6">
                                                    <Run Text="{Binding Duration, Converter={StaticResource DurationConverter}, Mode=OneWay}"/>
                                                    <Run Text=" • "/>
                                                    <Run Text="{Binding Timestamp, Converter={StaticResource RelativeTimeConverter}, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Victory/Defeat Badge -->
                                            <Border Grid.Column="2" 
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFF44336"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Victory}" Value="True">
                                                                <Setter Property="Background" Value="#FF4CAF50"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="Bold" 
                                                           FontSize="11"
                                                           Foreground="White"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="DEFEAT"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Victory}" Value="True">
                                                                    <Setter Property="Text" Value="VICTORY"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,20,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardContent}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=RecentMatchesControl, Path=Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="No matches played yet. Start your first battle!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- News & Updates Card -->
                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource DashboardCard}" Height="300">
                    <StackPanel>
                        <TextBlock Text="News &amp; Updates" Style="{StaticResource CardTitle}"/>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,30,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardContent}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Text" Value="There are currently no new updates."/>
                                    <!-- TODO: Only display if there are no updates -->
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <!--
                            <TextBlock Style="{StaticResource CardContent}" Margin="0,5">
                                <Run Text="•" FontWeight="Bold"/> 
                                <Run Text="New faction commanders available"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CardContent}" Margin="0,5">
                                <Run Text="•" FontWeight="Bold"/> 
                                <Run Text="Balance patch v2.1 deployed"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CardContent}" Margin="0,5">
                                <Run Text="•" FontWeight="Bold"/> 
                                <Run Text="Weekend tournament starting Friday"/>
                            </TextBlock>-->
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Featured Companies Card -->
                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource DashboardCard}" Height="220">
                    <StackPanel>
                        <TextBlock Text="Featured Companies" Style="{StaticResource CardTitle}"/>
                        <ItemsControl x:Name="FeaturedCompaniesControl" ItemsSource="{Binding FeaturedCompanies}" Margin="0,10,0,5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundLightBlueBrush}" 
                                            CornerRadius="6" 
                                            Padding="10" 
                                            Margin="0,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="40" Height="40" Margin="0,0,10,0">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource FactionIconConverter}">
                                                        <Binding Path="CompanyFaction"/>
                                                        <Binding Path="GameId"/>
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                            <StackPanel>
                                                <TextBlock Text="{Binding CompanyName}" 
                                                       Style="{StaticResource CardContent}" 
                                                       FontWeight="Bold"/>
                                                <TextBlock Style="{StaticResource CardContent}" 
                                                       FontSize="12" 
                                                       Opacity="0.7">
                                                <Run>
                                                    <Run.Text>
                                                        <MultiBinding Converter="{StaticResource FactionIdToNameConverter}">
                                                            <Binding Path="CompanyFaction"/>
                                                            <Binding Path="GameId"/>
                                                        </MultiBinding>
                                                    </Run.Text>
                                                </Run>
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding VeteranUnits, Mode=OneWay}"/>
                                                    <Run Text=" veteran units"/>
                                                <Run Text=" • " />
                                                <Run Text="{Binding PlayCount, Mode=OneWay}"/>
                                                <Run Text=" matches"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,20,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardContent}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=FeaturedCompaniesControl, Path=Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="No companies available. Create your first company!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Quick Stats Card -->
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource DashboardCard}" Height="220">
                    <StackPanel>
                        <TextBlock Text="Quick Stats" Style="{StaticResource CardTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Grid.Row="0" 
                                       Text="Favorite Faction:" 
                                       Style="{StaticResource CardContent}" 
                                       Margin="0,5"/>
                            <TextBlock Grid.Column="1" Grid.Row="0" 
                                       Text="{Binding MostPlayedFaction}" 
                                       Style="{StaticResource CardContent}" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Right" 
                                       Margin="0,5"/>

                            <TextBlock Grid.Column="0" Grid.Row="1" 
                                       Text="Favorite Map:" 
                                       Style="{StaticResource CardContent}" 
                                       Margin="0,5"/>
                                                        <TextBlock Grid.Column="1" Grid.Row="1" 
                                       Text="{Binding MostPlayedScenario}" 
                                       Style="{StaticResource CardContent}" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Right" 
                                       Margin="0,5"/>

                            <TextBlock Grid.Column="0" Grid.Row="2" 
                                       Text="Total Playtime:" 
                                       Style="{StaticResource CardContent}" 
                                       Margin="0,5"/>
                            <TextBlock Grid.Column="1" Grid.Row="2" 
                                       Text="{Binding TotalPlayTime}" 
                                       Style="{StaticResource CardContent}" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Right" 
                                       Margin="0,5"/>

                            <TextBlock Grid.Column="0" Grid.Row="3" 
                                       Text="Companies:" 
                                       Style="{StaticResource CardContent}" 
                                       Margin="0,5"/>
                            <TextBlock Grid.Column="1" Grid.Row="3" 
                                       Text="{Binding CompaniesOwned}" 
                                       Style="{StaticResource CardContent}" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Right" 
                                       Margin="0,5"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
