<UserControl x:Class="Battlegrounds.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Battlegrounds.ViewModels"
             xmlns:converters="clr-namespace:Battlegrounds.Converters"
             xmlns:controls="clr-namespace:Battlegrounds.Controls"
             d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200"
             Initialized="HomeView_Initialized">

    <UserControl.Resources>

        <converters:FactionIdToNameConverter x:Key="FactionIdToNameConverter"/>
        <converters:FactionIconMultiBindingConverter x:Key="FactionIconConverter"/>
        <converters:ScenarioIdToNameConverter x:Key="ScenarioIdToNameConverter"/>
        <converters:RelativeTimeConverter x:Key="RelativeTimeConverter"/>
        <converters:DurationConverter x:Key="DurationConverter"/>
        <converters:UpperCaseConverter x:Key="UpperCase"/>

        <!-- A row on a card: inset surface, hairline, faction tile then text then trailing slot. -->
        <Style x:Key="Home.Row" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Window}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Square tile behind a faction insignia. -->
        <Style x:Key="Home.FactionTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Faction.Axis}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Quick Stats: label left, value right, hairline underline. -->
        <Style x:Key="Home.StatRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Hairline}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,11"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource ScrollViewer.Thin}">
        <StackPanel Margin="0,0,8,0">

            <!-- ===================== Update banner ===================== -->

            <Border Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Status.Caution}"
                    BorderThickness="{StaticResource Stroke.EdgeLeftThick}"
                    Padding="22,16"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The one intentionally round thing on the screen: this is a
                         circular badge, not a rounded rectangle. The mockup draws it
                         the same way. -->
                    <Border Grid.Column="0"
                            Width="{DynamicResource Size.Icon.XL}" Height="{DynamicResource Size.Icon.XL}"
                            CornerRadius="22"
                            Background="{StaticResource Brush.Status.Caution}"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="↑"
                                   FontSize="{DynamicResource Font.Size.Cta}" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.OnAccent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <controls:TrackedTextBlock Text="NEW VERSION AVAILABLE"
                                                   FontFamily="{StaticResource Font.Heading}"
                                                   FontSize="{DynamicResource Font.Size.Section}"
                                                   FontWeight="SemiBold"
                                                   Tracking="{StaticResource Track.Snug}"
                                                   Foreground="{StaticResource Brush.Status.Caution}"/>
                        <TextBlock Style="{StaticResource Text.Body}" FontSize="{DynamicResource Font.Size.BodySmall}" Margin="0,2,0,0">
                            <Run Text="Version "/>
                            <Run Text="{Binding NewVersionNumber, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource Brush.Text.Primary}"/>
                            <Run Text=" is ready to install"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource Button.Caution}"
                            Content="INSTALL NOW"
                            Command="{Binding InstallUpdateCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ===================== Hero ===================== -->

            <controls:Card Padding="{DynamicResource Space.XXL}" Margin="0,0,0,16">
                <StackPanel>
                    <controls:TrackedTextBlock Style="{StaticResource Display.PageTitle}"
                                               FontSize="{DynamicResource Font.Size.Title}"
                                               Text="{Binding WelcomeMessage, Converter={StaticResource UpperCase}}"
                                               Margin="0,0,0,26"/>

                    <UniformGrid Columns="4">
                        <controls:StatTile Value="{Binding TotalMatches}" Label="TOTAL MATCHES"/>
                        <controls:StatTile Value="{Binding TotalVictories}" Label="VICTORIES"/>
                        <controls:StatTile Value="{Binding WinRate, StringFormat={}{0}%}" Label="WIN RATE"/>
                        <controls:StatTile Value="{Binding Rank, Converter={StaticResource UpperCase}}" Label="CURRENT RANK"/>
                    </UniformGrid>

                    <!--
                        Red, not the old green. The redesign gives the single loudest
                        action on a screen the primary colour, and primary is red.
                    -->
                    <Button Style="{StaticResource Button.Cta}"
                            Content="PLAY NOW"
                            FontSize="{DynamicResource Font.Size.Cta}"
                            Padding="{DynamicResource Space.XL}"
                            Margin="0,28,0,0"
                            Command="{Binding DataContext.SingleplayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </controls:Card>

            <!-- ===================== Card grid ===================== -->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Recent matches -->
                <controls:Card Grid.Column="0" Grid.Row="0" Header="RECENT MATCHES" MinHeight="290">
                    <Grid>
                        <ItemsControl x:Name="RecentMatchesControl" ItemsSource="{Binding RecentMatches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Home.Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource Home.FactionTile}">
                                                <Image Width="{DynamicResource Size.Icon.S}" Height="{DynamicResource Size.Icon.S}">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource FactionIconConverter}">
                                                            <Binding Path="CompanyFaction"/>
                                                            <Binding Path="GameId"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Strong}"
                                                           Text="{Binding CompanyName, Mode=OneWay}"/>
                                                <TextBlock Style="{StaticResource Text.Meta}">
                                                    <Run>
                                                        <Run.Text>
                                                            <MultiBinding Converter="{StaticResource FactionIdToNameConverter}">
                                                                <Binding Path="CompanyFaction"/>
                                                                <Binding Path="GameId"/>
                                                            </MultiBinding>
                                                        </Run.Text>
                                                    </Run>
                                                    <Run Text=" · "/>
                                                    <Run>
                                                        <Run.Text>
                                                            <MultiBinding Converter="{StaticResource ScenarioIdToNameConverter}">
                                                                <Binding Path="Map"/>
                                                                <Binding Path="GameId"/>
                                                            </MultiBinding>
                                                        </Run.Text>
                                                    </Run>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Duration, Converter={StaticResource DurationConverter}, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Timestamp, Converter={StaticResource RelativeTimeConverter}, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <controls:StatusBadge Grid.Column="2" Margin="10,0,0,0">
                                                <controls:StatusBadge.Style>
                                                    <Style TargetType="controls:StatusBadge"
                                                           BasedOn="{StaticResource {x:Type controls:StatusBadge}}">
                                                        <Setter Property="Content" Value="DEFEAT"/>
                                                        <Setter Property="Tone" Value="Danger"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Victory}" Value="True">
                                                                <Setter Property="Content" Value="VICTORY"/>
                                                                <Setter Property="Tone" Value="Success"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:StatusBadge.Style>
                                            </controls:StatusBadge>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No matches played yet. Start your first battle!">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Empty}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=RecentMatchesControl, Path=Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </controls:Card>

                <!-- News -->
                <controls:Card Grid.Column="2" Grid.Row="0" Header="NEWS &amp; UPDATES" MinHeight="290">
                    <TextBlock Style="{StaticResource Text.Empty}"
                               Text="There are currently no new updates."/>
                </controls:Card>

                <!-- Featured companies -->
                <controls:Card Grid.Column="0" Grid.Row="2" Header="FEATURED COMPANIES" MinHeight="210">
                    <Grid>
                        <ItemsControl x:Name="FeaturedCompaniesControl" ItemsSource="{Binding FeaturedCompanies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Home.Row}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Home.FactionTile}" Width="{DynamicResource Size.Icon.XL}" Height="{DynamicResource Size.Icon.XL}">
                                                <Image Width="{DynamicResource Size.Icon.M}" Height="{DynamicResource Size.Icon.M}">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource FactionIconConverter}">
                                                            <Binding Path="CompanyFaction"/>
                                                            <Binding Path="GameId"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Strong}"
                                                           Text="{Binding CompanyName}"/>
                                                <TextBlock Style="{StaticResource Text.Meta}">
                                                    <Run>
                                                        <Run.Text>
                                                            <MultiBinding Converter="{StaticResource FactionIdToNameConverter}">
                                                                <Binding Path="CompanyFaction"/>
                                                                <Binding Path="GameId"/>
                                                            </MultiBinding>
                                                        </Run.Text>
                                                    </Run>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding VeteranUnits, Mode=OneWay}"/>
                                                    <Run Text=" veteran units · "/>
                                                    <Run Text="{Binding PlayCount, Mode=OneWay}"/>
                                                    <Run Text=" matches"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No companies available. Create your first company!">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Empty}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=FeaturedCompaniesControl, Path=Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </controls:Card>

                <!-- Quick stats -->
                <controls:Card Grid.Column="2" Grid.Row="2" Header="QUICK STATS" MinHeight="210">
                    <StackPanel>
                        <Border Style="{StaticResource Home.StatRow}">
                            <Grid>
                                <TextBlock Style="{StaticResource Text.Body}" FontSize="{DynamicResource Font.Size.BodySmall}" Text="Favourite faction"/>
                                <TextBlock Style="{StaticResource Text.Strong}" HorizontalAlignment="Right">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource FactionIdToNameConverter}">
                                            <Binding Path="MostPlayedFaction"/>
                                            <Binding Path="MostPlayedFactionGameId"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Home.StatRow}">
                            <Grid>
                                <TextBlock Style="{StaticResource Text.Body}" FontSize="{DynamicResource Font.Size.BodySmall}" Text="Favourite map"/>
                                <TextBlock Style="{StaticResource Text.Strong}" HorizontalAlignment="Right">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ScenarioIdToNameConverter}">
                                            <Binding Path="MostPlayedScenario"/>
                                            <Binding Path="MostPlayedScenarioGameId"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Home.StatRow}">
                            <Grid>
                                <TextBlock Style="{StaticResource Text.Body}" FontSize="{DynamicResource Font.Size.BodySmall}" Text="Total playtime"/>
                                <TextBlock Style="{StaticResource Text.Strong}"
                                           HorizontalAlignment="Right"
                                           Text="{Binding TotalPlayTime}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Home.StatRow}" BorderThickness="0">
                            <Grid>
                                <TextBlock Style="{StaticResource Text.Body}" FontSize="{DynamicResource Font.Size.BodySmall}" Text="Companies"/>
                                <TextBlock Style="{StaticResource Text.Strong}"
                                           HorizontalAlignment="Right"
                                           Text="{Binding CompaniesOwned}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </controls:Card>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
