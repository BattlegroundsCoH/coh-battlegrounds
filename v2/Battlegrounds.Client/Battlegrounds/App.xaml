<Application x:Class="Battlegrounds.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Battlegrounds"
             xmlns:views="clr-namespace:Battlegrounds.Views">
    <Application.Resources>
        <!--
            Theme.xaml is still the only theme dictionary; the wrapper exists so that
            UiScaleService can append a Themes/Scale/*.xaml overlay after it at runtime.
            Merged dictionaries are searched last-to-first, so the overlay's token values
            win over the base ones and every {DynamicResource} re-resolves on the swap.
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Battlegrounds;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
