<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Battlegrounds</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <!-- Per-monitor DPI awareness; see the comments in the manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <PackageProjectUrl>https://cohbattlegrounds.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BattlegroundsCoH/coh-battlegrounds</RepositoryUrl>
    <Company>Battlegrounds Development Team</Company>
    <Authors>Battlegrounds Development Team</Authors>
    <Copyright>Copyright (C) 2026 Battlegrounds Development Team</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\auth.jpg" />
    <None Remove="Assets\dummy_avatar.png" />
    <None Remove="Rendering\Effects\ColourTintShader.ps" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App.ico" />
  </ItemGroup>

  <!--
    The pages the loopback sign-in listener serves to the browser. Embedded rather than copied
    to the output directory so they survive a self-contained publish and Velopack packaging as
    part of the assembly, and so they load without a WPF Application context (the listener tests
    have none). LogicalName is set explicitly rather than left to the default path-derived name,
    which the hyphen in the filename would otherwise make easy to get subtly wrong.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Auth\signin.html" LogicalName="Battlegrounds.Auth.SignIn.html" />
    <EmbeddedResource Include="Assets\Auth\notice.html" LogicalName="Battlegrounds.Auth.Notice.html" />
  </ItemGroup>

  <!--
    Design-system fonts, embedded so the app renders identically on a machine that has
    neither installed. Oswald's static weights are instanced from the upstream variable
    font (WPF only ever renders a variable font's default instance, so the four files
    are not optional). Both families are SIL OFL; embedding is redistribution, so the
    licences ship alongside the binary.
  -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\OFL-Oswald.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\OFL-JetBrainsMono.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\auth.jpg" />
    <Resource Include="Assets\BattlegroundsLogo.png" />
    <Resource Include="Rendering\Effects\ColourTintShader.ps" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Google.Protobuf" Version="3.34.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.78.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.5" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\dummy_avatar.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Factions\coh3\icons\" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\coh-battlegrounds-proto\lobby.proto" GrpcServices="Client">
      <Link>Protos\lobby.proto</Link>
    </Protobuf>
  </ItemGroup>

