<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        UI scale 110%. Merged after Theme.xaml by UiScaleService, so these win over the
        base values in Metrics.xaml and Typography.xaml.

        Values are hand-authored whole numbers, not base * 1.1 computed at runtime. A
        fractional font size lands glyphs on half-pixels, which defeats both
        TextOptions.TextFormattingMode="Display" and the device-pixel snapping
        TrackedTextBlock does for itself — see the crispness notes in CLAUDE.md.

        Only scale-sensitive tokens belong here. Radius.* and Stroke.* are deliberately
        absent: a hairline stays one physical pixel at every scale, and corners are 0.
        Track.* is absent because tracking is expressed in ems and scales with the font.
    -->

    <!-- ===================== Spacing ===================== -->

    <Thickness x:Key="Space.XS">4</Thickness>
    <Thickness x:Key="Space.S">9</Thickness>
    <Thickness x:Key="Space.M">13</Thickness>
    <Thickness x:Key="Space.L">18</Thickness>
    <Thickness x:Key="Space.XL">22</Thickness>
    <Thickness x:Key="Space.XXL">33</Thickness>

    <Thickness x:Key="Space.Page">22</Thickness>
    <Thickness x:Key="Space.Card">24</Thickness>
    <Thickness x:Key="Space.Row">10,13</Thickness>
    <Thickness x:Key="Space.Field">15,13</Thickness>
    <Thickness x:Key="Space.FieldInset">15,0</Thickness>
    <Thickness x:Key="Space.ComboField">13,0,33,0</Thickness>
    <Thickness x:Key="Space.Button">20,10</Thickness>
    <Thickness x:Key="Space.ButtonLarge">35,17</Thickness>
    <Thickness x:Key="Space.HeadingGap">0,0,0,15</Thickness>
    <Thickness x:Key="Space.StatGap">0,9,0,0</Thickness>
    <Thickness x:Key="Space.Badge">10,4</Thickness>

    <!-- ===================== Control sizing ===================== -->

    <sys:Double x:Key="Size.Control">40</sys:Double>
    <sys:Double x:Key="Size.ControlLarge">48</sys:Double>
    <sys:Double x:Key="Size.TopBar">66</sys:Double>
    <sys:Double x:Key="Size.NavItem">50</sys:Double>
    <sys:Double x:Key="Size.NavRail">220</sys:Double>
    <sys:Double x:Key="Size.NavRailCompact">165</sys:Double>
    <sys:Double x:Key="Size.NavLogo">176</sys:Double>

    <sys:Double x:Key="Size.Breakpoint.Medium">1540</sys:Double>
    <sys:Double x:Key="Size.Breakpoint.Expanded">1980</sys:Double>
    <sys:Double x:Key="Size.NavIndicator">4</sys:Double>
    <sys:Double x:Key="Size.ScrollBar">9</sys:Double>
    <sys:Double x:Key="Size.MenuRow">42</sys:Double>
    <sys:Double x:Key="Size.EyebrowRule">37</sys:Double>
    <sys:Double x:Key="Size.Icon.XS">18</sys:Double>
    <sys:Double x:Key="Size.Icon.S">22</sys:Double>
    <sys:Double x:Key="Size.Icon.M">26</sys:Double>
    <sys:Double x:Key="Size.Icon.L">35</sys:Double>
    <sys:Double x:Key="Size.Icon.XL">46</sys:Double>
    <sys:Double x:Key="Size.Icon.XXL">53</sys:Double>
    <sys:Double x:Key="Size.Icon.Huge">77</sys:Double>
    <sys:Double x:Key="Size.Dot">7</sys:Double>
    <sys:Double x:Key="Size.QuoteCard.MaxWidth">506</sys:Double>
    <sys:Double x:Key="Size.NewsCover.ThumbWidth">106</sys:Double>
    <sys:Double x:Key="Size.NewsGrid.MaxWidth">1540</sys:Double>

    <!-- ===================== Window ===================== -->
    <sys:Double x:Key="Size.Window.DefaultWidth">1890</sys:Double>
    <sys:Double x:Key="Size.Window.DefaultHeight">1080</sys:Double>
    <sys:Double x:Key="Size.Window.MinWidth">1300</sys:Double>
    <sys:Double x:Key="Size.Window.MinHeight">790</sys:Double>

    <!-- ===================== Type ===================== -->

    <sys:Double x:Key="Font.Size.DisplayLarge">51</sys:Double>
    <sys:Double x:Key="Font.Size.Display">44</sys:Double>
    <sys:Double x:Key="Font.Size.Title">33</sys:Double>
    <sys:Double x:Key="Font.Size.PageTitle">26</sys:Double>
    <sys:Double x:Key="Font.Size.Cta">24</sys:Double>
    <sys:Double x:Key="Font.Size.Heading">22</sys:Double>
    <sys:Double x:Key="Font.Size.Stat">37</sys:Double>
    <sys:Double x:Key="Font.Size.Section">18</sys:Double>
    <sys:Double x:Key="Font.Size.Group">20</sys:Double>
    <sys:Double x:Key="Font.Size.Eyebrow">13</sys:Double>
    <sys:Double x:Key="Font.Size.Body">15</sys:Double>
    <sys:Double x:Key="Font.Size.BodySmall">14</sys:Double>
    <sys:Double x:Key="Font.Size.Meta">12</sys:Double>
    <sys:Double x:Key="Font.Size.Label">11</sys:Double>

</ResourceDictionary>
