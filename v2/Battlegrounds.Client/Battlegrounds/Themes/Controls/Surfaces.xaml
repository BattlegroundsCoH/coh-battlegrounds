<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Battlegrounds.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Battlegrounds;component/Themes/Brushes.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Battlegrounds;component/Themes/Metrics.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Battlegrounds;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Default styles for the design-system controls in Battlegrounds.Controls.

        These are implicit (keyed by type), so dropping a <controls:Card/> into a view
        needs no Style reference. Tokens are addressed with {DynamicResource} throughout:
        Generic.xaml is resolved on its own, outside Application.Resources, so a
        {StaticResource} here would not find them.
    -->

    <!-- ===================== Card ===================== -->

    <Style TargetType="{x:Type controls:Card}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Hairline}" />
        <Setter Property="Padding" Value="{DynamicResource Space.Card}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Card}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <controls:TrackedTextBlock x:Name="Header"
                                                       DockPanel.Dock="Top"
                                                       Style="{DynamicResource Display.Section}"
                                                       Text="{TemplateBinding Header}"
                                                       Margin="{DynamicResource Space.HeadingGap}" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Eyebrow ===================== -->

    <Style TargetType="{x:Type controls:Eyebrow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Eyebrow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- The rule is red even though the label is gold; that contrast
                             is the whole point of the mark. -->
                        <Rectangle Width="{DynamicResource Size.EyebrowRule}"
                                   Height="2"
                                   Margin="0,0,14,0"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource Brush.Action.Primary}" />
                        <controls:TrackedTextBlock Style="{DynamicResource Display.Eyebrow}"
                                                   Text="{TemplateBinding Text}"
                                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== StatTile ===================== -->

    <Style TargetType="{x:Type controls:StatTile}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatTile}">
                    <StackPanel HorizontalAlignment="Center">
                        <controls:TrackedTextBlock Style="{DynamicResource Display.Stat}"
                                                   Text="{TemplateBinding Value}"
                                                   HorizontalAlignment="Center" />
                        <controls:TrackedTextBlock Style="{DynamicResource Display.StatLabel}"
                                                   Text="{TemplateBinding Label}"
                                                   HorizontalAlignment="Center"
                                                   Margin="{DynamicResource Space.StatGap}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== StatusBadge ===================== -->

    <Style TargetType="{x:Type controls:StatusBadge}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Heading}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Meta}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="controls:TrackedTextBlock.Tracking" Value="{DynamicResource Track.Wide}" />
        <Setter Property="Padding" Value="{DynamicResource Space.Badge}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusBadge}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <controls:TrackedTextBlock Text="{TemplateBinding Content}"
                                                   VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Filled chips pick their own foreground for contrast rather than
                 inheriting one: white is unreadable on green, gold and amber. -->
            <Trigger Property="Tone" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Brush.Status.Success}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            </Trigger>
            <Trigger Property="Tone" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Brush.Status.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}" />
            </Trigger>
            <Trigger Property="Tone" Value="Caution">
                <Setter Property="Background" Value="{DynamicResource Brush.Status.Caution}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            </Trigger>
            <Trigger Property="Tone" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Gold}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== PageHeader ===================== -->

    <Style TargetType="{x:Type controls:PageHeader}">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PageHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <controls:Eyebrow x:Name="Eyebrow"
                                              Text="{TemplateBinding Eyebrow}"
                                              Margin="0,0,0,10" />
                            <controls:TrackedTextBlock Style="{DynamicResource Display.PageTitle}"
                                                       Text="{TemplateBinding Header}" />
                        </StackPanel>

                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Eyebrow" Value="{x:Null}">
                            <Setter TargetName="Eyebrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Eyebrow" Value="">
                            <Setter TargetName="Eyebrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
