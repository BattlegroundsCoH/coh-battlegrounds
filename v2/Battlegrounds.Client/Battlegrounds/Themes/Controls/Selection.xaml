<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Battlegrounds;component/Themes/Brushes.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Battlegrounds;component/Themes/Metrics.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Battlegrounds;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Value-setting controls: the checkbox and the slider.

        Both render stock WPF chrome without a style — rounded, blue, Aero-era — which is
        why the match settings panel looked bolted on. They follow the same rules as the
        rest of the system: square, hairline borders, gold for the "on" state, dark text
        on any gold fill.

        The slider thumb is the one place a corner is allowed to soften, for the same
        reason the scrollbar thumb is: at 8px across, a square reads as a scratch.
    -->

    <!-- ===================== CheckBox ===================== -->

    <Style x:Key="CheckBox.Default" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Hairline}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodySmall}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="{DynamicResource Brush.Transparent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- The box tracks Size.Icon.XS so it stays square and in step
                             with the type beside it at every UI scale. -->
                        <Border x:Name="Box"
                                Width="{DynamicResource Size.Icon.XS}"
                                Height="{DynamicResource Size.Icon.XS}"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Margin="3"
                                  Stretch="Uniform"
                                  Opacity="0"
                                  Fill="{DynamicResource Brush.Text.OnAccent}"
                                  Data="M 0,5 L 4,9 L 12,0 L 14,2 L 4,13 L -2,7 Z" />
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Gold}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent.Gold}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Gold}" />
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Indeterminate is unused today, but an unstyled third state
                             would fall back to stock chrome the moment one appears. -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Gold}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slider ===================== -->

    <Style x:Key="Slider.Thumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip"
                            Width="{DynamicResource Size.Icon.XS}"
                            Height="{DynamicResource Size.Icon.S}"
                            Background="{DynamicResource Brush.Accent.Gold}"
                            CornerRadius="{DynamicResource Radius.Thumb}"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Brush.Accent.GoldHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Brush.Accent.GoldPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Horizontal only. A vertical slider would need its own template, and there is not
        one in the app — adding an unused orientation is how templates rot.
    -->
    <Style x:Key="Slider.Default" TargetType="Slider">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Gold}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="{DynamicResource Brush.Transparent}" VerticalAlignment="Center">
                        <!-- The rail is a hairline-tall bar, not a groove: it matches the
                             1px edges the rest of the system is drawn with. -->
                        <Border Height="4"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True" />

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Focusable="False"
                                              OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource Brush.Accent.Gold}"
                                                    SnapsToDevicePixels="True" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb Style="{StaticResource Slider.Thumb}" />
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Focusable="False"
                                              OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{DynamicResource Brush.Transparent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
