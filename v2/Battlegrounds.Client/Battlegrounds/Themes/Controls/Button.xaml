<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:Battlegrounds.Controls"
                    xmlns:converters="clr-namespace:Battlegrounds.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Battlegrounds;component/Themes/Brushes.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Battlegrounds;component/Themes/Metrics.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Battlegrounds;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Buttons.

        The design uses red as the primary call to action and gold as the accent, matching
        the website, where the `primary` token is red and gold is `warning`. So the loud,
        one-per-screen action — PLAY NOW, START MATCH, LOGIN — is Button.Cta in red, while
        the everyday actions — Refresh, New Company, Edit — are Button.Primary in gold.

        Button.Cta and Button.Danger are both red. That is faithful to the mockups, where
        START MATCH and LEAVE LOBBY sit side by side in the same colour; they are separated
        by size and tracking, not hue.

        Gold fills always take dark text. White on #e0a53b fails contrast badly.

        One template serves every variant. Per-variant state colours ride on
        ControlAssist attached properties and resolve through StateBrushConverter, because
        Setter.Value cannot be a binding in WPF.
    -->

    <converters:StateBrushConverter x:Key="StateBrush" />

    <ControlTemplate x:Key="Template.Button" TargetType="ButtonBase">
        <!--
            A ContentPresenter picks a DataTemplate by the content's type, so this one
            takes effect only when Content is a plain string — which is what gives button
            captions their tracking. Complex content (an icon beside a label) is untouched.

            It is scoped to the template rather than shared at dictionary level on purpose:
            an unkeyed string DataTemplate in Application.Resources would capture every
            ContentPresenter in the app.
        -->
        <ControlTemplate.Resources>
            <DataTemplate DataType="{x:Type sys:String}">
                <controls:TrackedTextBlock Text="{Binding}" />
            </DataTemplate>
        </ControlTemplate.Resources>

        <Border x:Name="Root"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <Border.Background>
                <MultiBinding Converter="{StaticResource StateBrush}">
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsMouseOver" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsPressed" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Background" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(controls:ControlAssist.HoverBackground)" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(controls:ControlAssist.PressedBackground)" />
                </MultiBinding>
            </Border.Background>
            <Border.BorderBrush>
                <MultiBinding Converter="{StaticResource StateBrush}">
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsMouseOver" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsPressed" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="BorderBrush" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(controls:ControlAssist.HoverBorderBrush)" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(controls:ControlAssist.HoverBorderBrush)" />
                </MultiBinding>
            </Border.BorderBrush>

            <ContentPresenter x:Name="Content"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="True" />
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===================== Base ===================== -->
    <!-- Not used directly; every variant below derives from it. -->

    <Style x:Key="Button.Base" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource Template.Button}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Heading}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="controls:TrackedTextBlock.Tracking" Value="{DynamicResource Track.Wide}" />
        <Setter Property="Padding" Value="{DynamicResource Space.Button}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Stroke.None}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Variants ===================== -->

    <!-- Gold. The default action: Refresh, New Company, Edit, Return to Lobby. -->
    <Style x:Key="Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Gold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="controls:ControlAssist.HoverBackground" Value="{DynamicResource Brush.Accent.GoldHover}" />
        <Setter Property="controls:ControlAssist.PressedBackground" Value="{DynamicResource Brush.Accent.GoldPressed}" />
    </Style>

    <!-- Red, loud, one per screen: PLAY NOW, START MATCH, LOGIN. -->
    <Style x:Key="Button.Cta" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Action.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}" />
        <Setter Property="controls:ControlAssist.HoverBackground" Value="{DynamicResource Brush.Action.PrimaryHover}" />
        <Setter Property="controls:ControlAssist.PressedBackground" Value="{DynamicResource Brush.Action.PrimaryPressed}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="controls:TrackedTextBlock.Tracking" Value="{DynamicResource Track.Widest}" />
        <Setter Property="Padding" Value="{DynamicResource Space.ButtonLarge}" />
    </Style>

    <!-- Red, ordinary size: Delete, Leave Lobby. -->
    <Style x:Key="Button.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}" />
        <Setter Property="controls:ControlAssist.HoverBackground" Value="{DynamicResource Brush.Status.DangerHover}" />
        <Setter Property="controls:ControlAssist.PressedBackground" Value="{DynamicResource Brush.Action.PrimaryPressed}" />
    </Style>

    <!-- Amber: Install Now, and anything else that warns rather than destroys. -->
    <Style x:Key="Button.Caution" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.Caution}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="controls:ControlAssist.HoverBackground" Value="{DynamicResource Brush.Status.CautionHover}" />
    </Style>

    <!-- Outlined and quiet: Edit Company, Continue with Discord/Steam, Send. -->
    <Style x:Key="Button.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Outline}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Hairline}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="controls:ControlAssist.HoverBackground" Value="{DynamicResource Brush.Surface.Hover}" />
        <Setter Property="controls:ControlAssist.HoverBorderBrush" Value="{DynamicResource Brush.Accent.Gold}" />
        <Setter Property="controls:ControlAssist.PressedBackground" Value="{DynamicResource Brush.Surface.Pressed}" />
        <Setter Property="Padding" Value="{DynamicResource Space.Field}" />
    </Style>

    <!-- Filled but recessive: sits on a card and reads as a control, not a call to action. -->
    <Style x:Key="Button.Subtle" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Hairline}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="controls:ControlAssist.HoverBackground" Value="{DynamicResource Brush.Surface.Hover}" />
        <Setter Property="controls:ControlAssist.HoverBorderBrush" Value="{DynamicResource Brush.Accent.Gold}" />
    </Style>

    <!-- No chrome at all: a hit target around an icon or a row of text. -->
    <Style x:Key="Button.Bare" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="controls:TrackedTextBlock.Tracking" Value="0" />
        <Setter Property="controls:ControlAssist.HoverBackground" Value="{DynamicResource Brush.Surface.Hover}" />
    </Style>

    <!-- A row in the profile dropdown: full-width, left-aligned, no border. -->
    <Style x:Key="Button.Menu" TargetType="ButtonBase" BasedOn="{StaticResource Button.Bare}">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodySmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <!--
        Nav rail item. A RadioButton so that selection is mutually exclusive, with the
        gold indicator bar sitting outside the fill — hence its own template rather than
        the shared one.
    -->
    <Style x:Key="Button.Nav" TargetType="RadioButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Heading}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="controls:TrackedTextBlock.Tracking" Value="{DynamicResource Track.Snug}" />
        <Setter Property="Height" Value="{DynamicResource Size.NavItem}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <ControlTemplate.Resources>
                        <DataTemplate DataType="{x:Type sys:String}">
                            <controls:TrackedTextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>

                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Indicator"
                                Grid.Column="0"
                                Width="{DynamicResource Size.NavIndicator}"
                                Background="{DynamicResource Brush.Accent.Gold}"
                                Opacity="0" />

                        <Border x:Name="Fill"
                                Grid.Column="1"
                                Background="{DynamicResource Brush.Surface.Card}"
                                Padding="16,0">
                            <ContentPresenter x:Name="Content"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Indicator" Property="Opacity" Value="0.6" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
